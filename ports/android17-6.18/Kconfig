config QCOM_SCM
	tristate "Onyx Qualcomm secure monitor module"
	help
	  Build the pinned Onyx vendor SCM implementation as an external module.

config QTEE_SHM_BRIDGE
	bool "Onyx QTEE shared memory bridge"
	depends on QCOM_SCM
	help
	  The Onyx SCM module includes the vendor shared-memory bridge allocator.

config IPC_LOGGING
	tristate "Qualcomm IPC logging"

config IPC_LOGGING_CDEV
	bool "IPC log character device"
	depends on IPC_LOGGING

config IPC_LOG_MINIDUMP_BUFFERS
	int "IPC log buffers registered with minidump"
	depends on IPC_LOGGING
	default 16

config QCOM_CRM_V2
	tristate "Onyx clock resource manager v2"

config QCOM_RPMH_TIMEOUT
	int "RPMh and CRM request timeout in milliseconds"
	default 5000

config REGMAP_QTI_DEBUGFS
	tristate "Qualcomm register map debugfs"
	depends on DEBUG_FS

config REGULATOR_DEBUG_CONTROL
	tristate "Qualcomm regulator debug controls"
	depends on REGULATOR && DEBUG_FS

config REGULATOR_PROXY_CONSUMER
	tristate "Qualcomm regulator proxy consumers"
	depends on REGULATOR

config REGULATOR_PROXY_CONSUMER_LEGACY
	bool "Legacy boot proxy votes"
	depends on REGULATOR_PROXY_CONSUMER

config REGULATOR_RPMH
	tristate "Onyx RPMh regulators"
	depends on REGULATOR

