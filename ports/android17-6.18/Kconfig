config QCOM_SCM
	tristate "Onyx Qualcomm secure monitor module"
	help
	  Build the pinned Onyx vendor SCM implementation as an external module.

config QTEE_SHM_BRIDGE
	bool "Onyx QTEE shared memory bridge"
	depends on QCOM_SCM
	help
	  The Onyx SCM module includes the vendor shared-memory bridge allocator.
