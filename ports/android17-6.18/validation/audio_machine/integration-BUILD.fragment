ddk_module(
    name = "machine_dlkm",
    srcs = ["qcom/opensource/audio-kernel/asoc/msm_common.c", "qcom/opensource/audio-kernel/asoc/sun.c", ":qcom/opensource/audio-kernel/config/sunautoconf.h"],
