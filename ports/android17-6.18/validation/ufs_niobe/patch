Subject: Add native Niobe UFS PHY and propagate probe errors

Preserve native calibration tables and return provider registration errors.
Reject unsupported calibration modes before asserting PHY reset.

---

diff --git a/drivers/phy/qualcomm/phy-qcom-ufs.c b/drivers/phy/qualcomm/phy-qcom-ufs.c
index 63379ea32956..3099655dd18c 100644
--- a/drivers/phy/qualcomm/phy-qcom-ufs.c
+++ b/drivers/phy/qualcomm/phy-qcom-ufs.c
@@ -194,7 +194,7 @@ struct phy *ufs_qcom_phy_generic_probe(struct platform_device *pdev,
 	INIT_LIST_HEAD(&common_cfg->regs_list_head);
 
 out:
-	return generic_phy;
+	return err ? ERR_PTR(err) : generic_phy;
 }
 EXPORT_SYMBOL(ufs_qcom_phy_generic_probe);
 
diff --git a/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-sun.c b/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-sun.c
index bc04d92c5a16..6a1ef9cfb851 100644
--- a/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-sun.c
+++ b/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-sun.c
@@ -340,10 +340,10 @@ static int ufs_qcom_phy_qmp_v4_probe(struct platform_device *pdev)
 	generic_phy = ufs_qcom_phy_generic_probe(pdev, &phy->common_cfg,
 				&ufs_qcom_phy_qmp_v4_phy_ops, &phy_v4_ops);
 
-	if (!generic_phy) {
+	if (IS_ERR(generic_phy)) {
 		dev_err(dev, "%s: ufs_qcom_phy_generic_probe() failed\n",
 			__func__);
-		err = -EIO;
+		err = PTR_ERR(generic_phy);
 		goto out;
 	}
 
diff --git a/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-niobe.c b/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-niobe.c
index 458df64f9b4d..d62492211c00 100644
--- a/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-niobe.c
+++ b/drivers/phy/qualcomm/phy-qcom-ufs-qmp-v4-niobe.c
@@ -18,12 +18,6 @@ static int ufs_qcom_phy_qmp_v4_phy_calibrate(struct phy *generic_phy)
 	int submode;
 	int err;
 
-	err = reset_control_assert(ufs_qcom_phy->ufs_reset);
-	if (err) {
-		dev_err(dev, "Failed to assert UFS PHY reset %d\n", err);
-		goto out;
-	}
-
 	/* For UFS PHY's submode, 2 = G5, 1 = G4, 0 = non-G4/G5 */
 	submode = ufs_qcom_phy->submode;
 	if (submode != UFS_QCOM_PHY_SUBMODE_G4 &&
@@ -32,6 +26,14 @@ static int ufs_qcom_phy_qmp_v4_phy_calibrate(struct phy *generic_phy)
 		return -EOPNOTSUPP;
 	}
 
+
+	err = reset_control_assert(ufs_qcom_phy->ufs_reset);
+	if (err) {
+		dev_err(dev, "Failed to assert UFS PHY reset %d\n", err);
+		goto out;
+	}
+
+
 	is_rate_B = (ufs_qcom_phy->mode == PHY_MODE_UFS_HS_B) ? true : false;
 
 	writel_relaxed(0x01, ufs_qcom_phy->mmio + UFS_PHY_SW_RESET);
@@ -320,10 +322,10 @@ static int ufs_qcom_phy_qmp_v4_probe(struct platform_device *pdev)
 	generic_phy = ufs_qcom_phy_generic_probe(pdev, &phy->common_cfg,
 				&ufs_qcom_phy_qmp_v4_phy_ops, &phy_v4_ops);
 
-	if (!generic_phy) {
+	if (IS_ERR(generic_phy)) {
 		dev_err(dev, "%s: ufs_qcom_phy_generic_probe() failed\n",
 			__func__);
-		err = -EIO;
+		err = PTR_ERR(generic_phy);
 		goto out;
 	}
 
