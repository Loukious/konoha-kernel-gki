Subject: Port native QRTR MHI, SMD and TUN transports

Retain native transport units and interfaces. Drain MHI sends before endpoint
withdrawal, balance retry socket ownership and reject malformed SMD previews.

---

diff --git a/net/qrtr/mhi.c b/net/qrtr/mhi.c
index 714095354867..c004fad7103c 100644
--- a/net/qrtr/mhi.c
+++ b/net/qrtr/mhi.c
@@ -21,6 +21,7 @@ struct qrtr_mhi_dev {
 	struct device *dev;
 	struct completion prepared;
 	struct completion ringfull;
+	bool stopping;
 };
 
 /* From MHI to QRTR */
@@ -54,11 +55,12 @@ static void qcom_mhi_qrtr_ul_callback(struct mhi_device *mhi_dev,
 }
 
 /* Send data over MHI */
-static int __qcom_mhi_qrtr_send(struct qrtr_endpoint *ep, struct sk_buff *skb)
+static int qcom_mhi_qrtr_send(struct qrtr_endpoint *ep, struct sk_buff *skb)
 {
 	struct qrtr_mhi_dev *qdev = container_of(ep, struct qrtr_mhi_dev, ep);
 	int rc;
 
+	/* The completion callback releases exactly one extra socket reference. */
 	if (skb->sk)
 		sock_hold(skb->sk);
 
@@ -70,34 +72,36 @@ static int __qcom_mhi_qrtr_send(struct qrtr_endpoint *ep, struct sk_buff *skb)
 	if (rc)
 		goto free_skb;
 
-	rc = mhi_queue_skb(qdev->mhi_dev, DMA_TO_DEVICE, skb, skb->len,
-			   MHI_EOT);
-	if (rc && rc != -EAGAIN)
-		goto free_skb;
-
-	return rc;
+	for (;;) {
+		reinit_completion(&qdev->ringfull);
+		if (READ_ONCE(qdev->stopping)) {
+			rc = -ENODEV;
+			goto free_skb;
+		}
+		rc = mhi_queue_skb(qdev->mhi_dev, DMA_TO_DEVICE, skb,
+				   skb->len, MHI_EOT);
+		if (!rc)
+			return 0;
+		if (rc != -EAGAIN)
+			goto free_skb;
+		rc = wait_for_completion_interruptible(&qdev->ringfull);
+		if (rc)
+			goto free_skb;
+	}
 
 free_skb:
 	if (skb->sk)
 		sock_put(skb->sk);
 	kfree_skb(skb);
-
 	return rc;
 }
 
-static int qcom_mhi_qrtr_send(struct qrtr_endpoint *ep, struct sk_buff *skb)
+static void qcom_mhi_qrtr_stop(struct qrtr_mhi_dev *qdev)
 {
-	struct qrtr_mhi_dev *qdev = container_of(ep, struct qrtr_mhi_dev, ep);
-	int rc;
-
-	do {
-		reinit_completion(&qdev->ringfull);
-		rc = __qcom_mhi_qrtr_send(ep, skb);
-		if (rc == -EAGAIN)
-			wait_for_completion(&qdev->ringfull);
-	} while (rc == -EAGAIN);
-
-	return rc;
+	WRITE_ONCE(qdev->stopping, true);
+	/* Unblock xmit before endpoint_unregister takes the endpoint lock. */
+	complete_all(&qdev->prepared);
+	complete_all(&qdev->ringfull);
 }
 
 static void qrtr_mhi_of_parse(struct mhi_device *mhi_dev,
@@ -110,6 +114,9 @@ static void qrtr_mhi_of_parse(struct mhi_device *mhi_dev,
 	int rc;
 
 	*net_id = QRTR_EP_NET_ID_AUTO;
+	*rt = false;
+	if (!dev_is_pci(mhi_cntrl->cntrl_dev))
+		return;
 
 	np = of_find_compatible_node(np, NULL, "qcom,qrtr-mhi");
 	if (!np)
@@ -151,13 +158,17 @@ static int qcom_mhi_qrtr_probe(struct mhi_device *mhi_dev,
 	qrtr_mhi_of_parse(mhi_dev, &net_id, &rt);
 
 	rc = qrtr_endpoint_register(&qdev->ep, net_id, rt, NULL);
-	if (rc)
+	if (rc) {
+		dev_set_drvdata(&mhi_dev->dev, NULL);
 		return rc;
+	}
 
 	/* start channels */
 	rc = mhi_prepare_for_transfer_autoqueue(mhi_dev);
 	if (rc) {
+		qcom_mhi_qrtr_stop(qdev);
 		qrtr_endpoint_unregister(&qdev->ep);
+		dev_set_drvdata(&mhi_dev->dev, NULL);
 		return rc;
 	}
 	complete_all(&qdev->prepared);
@@ -171,6 +182,7 @@ static void qcom_mhi_qrtr_remove(struct mhi_device *mhi_dev)
 {
 	struct qrtr_mhi_dev *qdev = dev_get_drvdata(&mhi_dev->dev);
 
+	qcom_mhi_qrtr_stop(qdev);
 	qrtr_endpoint_unregister(&qdev->ep);
 	mhi_unprepare_from_transfer(mhi_dev);
 	dev_set_drvdata(&mhi_dev->dev, NULL);
diff --git a/net/qrtr/smd.c b/net/qrtr/smd.c
index 048dbf5900a3..23bedce1436f 100644
--- a/net/qrtr/smd.c
+++ b/net/qrtr/smd.c
@@ -34,11 +34,11 @@ static int qcom_smd_qrtr_callback(struct rpmsg_device *rpdev,
 	rc = qrtr_endpoint_post(&qdev->ep, data, len);
 	if (rc == -EINVAL) {
 		dev_err(qdev->dev, "invalid ipcrouter packet\n");
-		/* return 0 to let smd drop the packet */
-		rc = 0;
+		/* Drop malformed packets without parsing a wakeup preview. */
+		return 0;
 	}
 
-	if (qcom_glink_is_wakeup(true))
+	if (!rc && qcom_glink_is_wakeup(true))
 		qrtr_print_wakeup_reason(data);
 
 	return rc;
@@ -97,8 +97,14 @@ static int qcom_smd_qrtr_probe(struct rpmsg_device *rpdev)
 		if (!svc_arr.arr)
 			return -ENOMEM;
 
-		of_property_read_u32_array(rpdev->dev.of_node, "qcom,no-wake-svc",
-					   svc_arr.arr, size);
+		rc = of_property_read_u32_array(rpdev->dev.of_node,
+						"qcom,no-wake-svc", svc_arr.arr, size);
+		if (rc) {
+			kfree(svc_arr.arr);
+			return rc;
+		}
+	} else if (size != -EINVAL && size != -ENODATA && size < 0) {
+		return size;
 	}
 
 	rc = qrtr_endpoint_register(&qdev->ep, net_id, rt, &svc_arr);
