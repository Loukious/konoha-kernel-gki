#include <assert.h>
#include <errno.h>
#include <limits.h>
#include <pthread.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <stddef.h>
#include <string.h>

typedef uint32_t u32;
typedef uint8_t u8;
#define READ_ONCE(x) __atomic_load_n(&(x), __ATOMIC_ACQUIRE)
#define WRITE_ONCE(x, val) __atomic_store_n(&(x), (val), __ATOMIC_RELEASE)
#define container_of(ptr, type, field) ((type *)((char *)(ptr) - offsetof(type, field)))
#define dev_err_ratelimited(...) ((void)0)
#define pr_err_ratelimited(...) ((void)0)
#define pr_debug(...) ((void)0)
#define dev_dbg(...) ((void)0)
#define LPASS_CDC_@UP@_RX0_RX_VOL_CTL 0
#define LPASS_CDC_@UP@_RX1_RX_VOL_CTL 1

struct mutex { pthread_mutex_t native; };
static void mutex_lock(struct mutex *m) { assert(!pthread_mutex_lock(&m->native)); }
static void mutex_unlock(struct mutex *m) { assert(!pthread_mutex_unlock(&m->native)); }
struct work_struct { int tag; };
struct delayed_work { int tag; };
struct device_node { int tag; };
struct device { struct device_node *of_node; };
struct platform_device { struct device dev; };
struct snd_soc_component { bool dead; };
struct thermal_cooling_device { void *devdata; };
struct lpass_cdc_@KIND@_macro_priv {
    struct device *dev;
    struct snd_soc_component *component;
    struct mutex component_lock;
    bool dapm_mclk_enable;
    u8 rx0_origin_gain, rx1_origin_gain;
    u32 thermal_cur_state, thermal_max_state;
    struct work_struct lpass_cdc_@KIND@_macro_cooling_work;
    struct { struct delayed_work dwork; } wsa_vi_dec_enable_work;
};
static struct lpass_cdc_@KIND@_macro_priv *active;
static unsigned int queued, cooling_cancelled, vi_cancelled, writes;
static u8 written[2];
static bool block_write, write_entered, write_continue, deinit_entered, deinit_done;
static pthread_mutex_t gate = PTHREAD_MUTEX_INITIALIZER;
static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
static int snd_soc_component_update_bits(struct snd_soc_component *component,
                                         unsigned int reg, unsigned int mask, unsigned int value)
{
    assert(component && !component->dead && reg < 2 && mask == 255 && value < 256);
    assert(pthread_mutex_trylock(&active->component_lock.native) == EBUSY);
    pthread_mutex_lock(&gate);
    if (block_write && !write_entered) {
        write_entered = true;
        pthread_cond_broadcast(&changed);
        while (!write_continue) pthread_cond_wait(&changed, &gate);
    }
    pthread_mutex_unlock(&gate);
    assert(!component->dead);
    written[reg] = value;
    writes++;
    return 0;
}
static void schedule_work(struct work_struct *work)
{
    assert(work == &active->lpass_cdc_@KIND@_macro_cooling_work);
    queued++;
}
static void cancel_work_sync(struct work_struct *work)
{
    assert(work == &active->lpass_cdc_@KIND@_macro_cooling_work);
    cooling_cancelled++;
}
static void cancel_delayed_work_sync(struct delayed_work *work)
{
    assert(work == &active->wsa_vi_dec_enable_work.dwork);
    vi_cancelled++;
}
static bool lpass_cdc_@KIND@_macro_get_data(struct snd_soc_component *component,
                                          struct device **dev,
                                          struct lpass_cdc_@KIND@_macro_priv **priv,
                                          const char *name)
{
    (void)name;
    if (!component || component != active->component) return false;
    *dev = active->dev;
    *priv = active;
    return true;
}
static bool property_present;
static int property_size, property_error, property_reads;
static int property;
static void *of_find_property(struct device_node *node, const char *name, int *size)
{
    assert(node && name);
    if (!property_present) return NULL;
    *size = property_size;
    return &property;
}
static int of_property_read_u32_array(struct device_node *node, const char *name,
                                     u32 *output, unsigned int count)
{
    assert(node && name && output && count == 2);
    property_reads++;
    if (property_error) return property_error;
    output[0] = 7;
    output[1] = 9;
    return 0;
}

#include "lifecycle.inc"

static void *cooling_thread(void *unused)
{
    (void)unused;
    lpass_cdc_@KIND@_macro_cooling_adjust_gain(&active->lpass_cdc_@KIND@_macro_cooling_work);
    return NULL;
}
static void *deinit_thread(void *component)
{
    pthread_mutex_lock(&gate);
    deinit_entered = true;
    pthread_cond_broadcast(&changed);
    pthread_mutex_unlock(&gate);
    assert(!lpass_cdc_@KIND@_macro_deinit(component));
    pthread_mutex_lock(&gate);
    deinit_done = true;
    pthread_cond_broadcast(&changed);
    pthread_mutex_unlock(&gate);
    return NULL;
}

int main(void)
{
    struct device_node node = {0};
    struct platform_device pdev = {.dev = {.of_node = &node}};
    struct snd_soc_component component = {0};
    struct lpass_cdc_@KIND@_macro_priv priv = {.dev = &pdev.dev, .thermal_max_state = 11};
    struct thermal_cooling_device cdev = {.devdata = &priv};
    unsigned long state;
    u32 values[2] = {0};
    active = &priv;
    assert(!pthread_mutex_init(&priv.component_lock.native, NULL));

    assert(!lpass_cdc_@KIND@_macro_get_max_state(&cdev, &state) && state == 11);
    assert(lpass_cdc_@KIND@_macro_set_cur_state(&cdev, 12) == -EINVAL && !queued);
    assert(lpass_cdc_@KIND@_macro_set_cur_state(&cdev, ULONG_MAX) == -EINVAL && !queued);
    assert(!lpass_cdc_@KIND@_macro_set_cur_state(&cdev, 4) && queued == 1);
    assert(!lpass_cdc_@KIND@_macro_get_cur_state(&cdev, &state) && state == 4);
    cdev.devdata = NULL;
    assert(lpass_cdc_@KIND@_macro_get_max_state(&cdev, &state) == -EINVAL);
    assert(lpass_cdc_@KIND@_macro_get_cur_state(&cdev, &state) == -EINVAL);
    assert(lpass_cdc_@KIND@_macro_set_cur_state(&cdev, 0) == -EINVAL);
    cdev.devdata = &priv;
    cooling_thread(NULL);
    assert(!writes);
    priv.component = &component;
    cooling_thread(NULL);
    assert(!writes);
    priv.dapm_mclk_enable = true;
    priv.rx0_origin_gain = 6;
    priv.rx1_origin_gain = 0;
    cooling_thread(NULL);
    assert(writes == 2 && written[0] == 2 && written[1] == 252);

    assert(!lpass_cdc_@KIND@_macro_read_array(&pdev, "native", 2, values));
    assert(!values[0] && !values[1] && !property_reads);
    property_present = true;
    for (int bytes = 0; bytes <= 17; bytes++) {
        property_size = bytes;
        int result = lpass_cdc_@KIND@_macro_read_array(&pdev, "native", 2, values);
        assert(bytes == 8 ? result == 0 : result == -EINVAL);
    }
    assert(property_reads == 1 && values[0] == 7 && values[1] == 9);
    property_size = 8;
    property_error = -EIO;
    assert(lpass_cdc_@KIND@_macro_read_array(&pdev, "native", 2, values) == -EIO);

    for (int race = 0; race < 100; race++) {
        priv.component = &component;
        component.dead = false;
        block_write = true;
        write_entered = write_continue = deinit_entered = deinit_done = false;
        pthread_t worker, teardown;
        assert(!pthread_create(&worker, NULL, cooling_thread, NULL));
        pthread_mutex_lock(&gate);
        while (!write_entered) pthread_cond_wait(&changed, &gate);
        pthread_mutex_unlock(&gate);
        assert(!pthread_create(&teardown, NULL, deinit_thread, &component));
        pthread_mutex_lock(&gate);
        while (!deinit_entered) pthread_cond_wait(&changed, &gate);
        assert(!deinit_done);
        write_continue = true;
        pthread_cond_broadcast(&changed);
        pthread_mutex_unlock(&gate);
        assert(!pthread_join(worker, NULL));
        assert(!pthread_join(teardown, NULL));
        assert(deinit_done && !priv.component && cooling_cancelled == (unsigned int)race + 1);
        if (!strcmp("@KIND@", "wsa")) assert(vi_cancelled == (unsigned int)race + 1);
        component.dead = true;
        unsigned int previous_writes = writes;
        cooling_thread(NULL);
        assert(writes == previous_writes);
    }
    assert(!pthread_mutex_destroy(&priv.component_lock.native));
    puts("{\"thermal_state_cases\":8,\"component_gates\":3,\"native_gain_case\":1,\"dt_array_cases\":20,\"cooling_deinit_races\":100}");
}
