+/**
+ * msm_ext_disp_unregister_audio_codec() - withdraw caller-owned codec storage
+ * @pdev: external display platform device
+ * @ops: the exact table passed to registration
+ *
+ * Drains accesses to @ops before returning. The caller must first quiesce its
+ * own users. Ready notifications use an independent callback snapshot. A
+ * synchronous extcon notifier may withdraw while its task owns publication;
+ * neither notification path accesses @ops afterwards. Self-withdrawal does
+ * not wait for its own callback. Other tasks drain the publication lock.
+ *
+ * Return: 0 if withdrawn or already absent, -ENOENT for a different live table,
+ * -EINVAL for invalid arguments, or -ENODEV if the provider is unavailable.
+ */
+int msm_ext_disp_unregister_audio_codec(struct platform_device *pdev,
+					struct msm_ext_disp_audio_codec_ops *ops);
 
