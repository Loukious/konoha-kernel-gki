+static int msm_ext_disp_withdraw_audio_locked(struct msm_ext_disp *ext_disp,
+					      struct msm_ext_disp_audio_codec_ops *ops)
+{
+	lockdep_assert_held(&ext_disp->lock);
+	if (ext_disp->ops && ext_disp->ops != ops)
+		return -ENOENT;
+	ext_disp->ops = NULL;
+	return 0;
+}
+
+int msm_ext_disp_unregister_audio_codec(struct platform_device *pdev,
+					struct msm_ext_disp_audio_codec_ops *ops)
+{
+	struct msm_ext_disp_data *data;
+	struct msm_ext_disp *ext_disp;
+	int ret = 0;
+
+	if (!pdev || !ops)
+		return -EINVAL;
+	data = platform_get_drvdata(pdev);
+	if (!data)
+		return -ENODEV;
+	ext_disp = container_of(data, struct msm_ext_disp, ext_disp_data);
+
+	/* extcon notifiers run synchronously with the publication lock held. */
+	if (READ_ONCE(ext_disp->notify_owner) == current)
+		return msm_ext_disp_withdraw_audio_locked(ext_disp, ops);
+
+	/* Every access to the caller's table, including ready, uses this lock. */
+	mutex_lock(&ext_disp->lock);
+	ret = msm_ext_disp_withdraw_audio_locked(ext_disp, ops);
+	mutex_unlock(&ext_disp->lock);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(msm_ext_disp_unregister_audio_codec);
 
