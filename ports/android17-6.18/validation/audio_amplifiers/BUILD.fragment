ddk_headers(
    name = "audio_amplifier_headers",
    hdrs = ["qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_bin_parse.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_calib.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_data_type.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_device.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_dsp.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_init.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_log.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_monitor.h", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_spin.h", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_91xx.h", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_common.h", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_parameter.h", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_regmap.h", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_tuning_if.h", "qcom/opensource/audio-kernel/config/sunautoconf.h", "qcom/opensource/audio-kernel/asoc/msm_common.h", "include/miev/mievent.h"],
    includes = ["qcom/opensource/audio-kernel/asoc"],
    linux_includes = ["include"],
    visibility = ["//visibility:public"],
)

ddk_module(
    name = "aw882xx_dlkm",
    srcs = ["qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx.c", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_bin_parse.c", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_calib.c", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_device.c", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_dsp.c", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_init.c", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_monitor.c", "qcom/opensource/audio-kernel/asoc/codecs/aw882xx/aw882xx_spin.c", "qcom/opensource/audio-kernel/config/sunautoconf.h"],
    out = "aw882xx_dlkm.ko",
    kernel_build = "//common:kernel_aarch64",
    kconfig = "Kconfig",
    defconfig = "platform_defconfig",
    deps = [":audio_amplifier_headers", "//onyx_audio_machine:machine_dlkm", "//onyx:miev"],
    copts = ["-DDEBUG", "-include", "$(location qcom/opensource/audio-kernel/config/sunautoconf.h)"],
    visibility = ["//visibility:public"],
)

ddk_module(
    name = "sia91xx_dlkm",
    srcs = ["qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa.c", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_regmap.c", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_aux_dev_if.c", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_91xx.c", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_parameter.c", "qcom/opensource/audio-kernel/config/sunautoconf.h"],
    out = "sia91xx_dlkm.ko",
    kernel_build = "//common:kernel_aarch64",
    kconfig = "Kconfig",
    defconfig = "platform_defconfig",
    deps = [":audio_amplifier_headers", "//onyx_audio_machine:machine_dlkm"],
    copts = ["-include", "$(location qcom/opensource/audio-kernel/config/sunautoconf.h)"],
    visibility = ["//visibility:public"],
)

ddk_module(
    name = "sia91xx_tuning_dlkm",
    srcs = ["qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_tuning_misc.c", "qcom/opensource/audio-kernel/asoc/codecs/sia91xx/sipa_tuning_if.c", "qcom/opensource/audio-kernel/config/sunautoconf.h"],
    out = "sia91xx_tuning_dlkm.ko",
    kernel_build = "//common:kernel_aarch64",
    kconfig = "Kconfig",
    defconfig = "platform_defconfig",
    deps = [":audio_amplifier_headers"],
    copts = ["-include", "$(location qcom/opensource/audio-kernel/config/sunautoconf.h)"],
    visibility = ["//visibility:public"],
)

