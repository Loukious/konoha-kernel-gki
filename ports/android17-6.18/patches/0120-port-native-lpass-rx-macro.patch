+/* Called only after children and component callbacks have drained. */
+static void lpass_cdc_rx_macro_release_clocks(struct lpass_cdc_rx_macro_priv *rx_priv)
+{
+	int ret;
+	bool voted = false;
+
+	while (rx_priv->swr_clk_users || rx_priv->swr_mclk_owned ||
+	       rx_priv->swr_pins_owned || rx_priv->swr_enabled) {
+		ret = rx_swrm_clock(rx_priv, false);
+		if (ret) {
+			dev_err(rx_priv->dev, "RX SWR cleanup failed: %d\n", ret);
+			break;
+		}
+	}
+	/* FIR cleanup already attempted its stop sequence while ALSA was live. */
+	if (rx_priv->fir_clock_owned) {
+		dev_err(rx_priv->dev, "RX FIR stop failed; releasing its final clock vote\n");
+		clk_disable_unprepare(rx_priv->hifi_fir_clk);
+		rx_priv->fir_clock_owned = false;
+	}
+	if (!rx_priv->swr_mclk_owned) {
+		while (rx_priv->rx_mclk_users) {
+			ret = lpass_cdc_rx_macro_mclk_enable(rx_priv, false, false);
+			if (ret) {
+				dev_err(rx_priv->dev, "RX MCLK cleanup failed: %d\n", ret);
+				break;
+			}
+		}
+	}
+	mutex_lock(&rx_priv->mclk_lock);
+	if (!rx_priv->failed_clock_owned && !rx_priv->ssr_clock_owned)
+		goto out;
+	if (READ_ONCE(rx_priv->pre_dev_up)) {
+		ret = lpass_cdc_rx_macro_core_vote(rx_priv, true);
+		if (ret) {
+			dev_err(rx_priv->dev, "RX final core vote failed: %d\n", ret);
+			goto out;
+		}
+		voted = true;
+	}
+	if (rx_priv->failed_clock_owned) {
+		ret = lpass_cdc_clk_rsc_request_clock(rx_priv->dev,
+						      rx_priv->default_clk_id,
+						      rx_priv->clk_id, false);
+		if (!ret)
+			rx_priv->failed_clock_owned = false;
+		else
+			dev_err(rx_priv->dev, "RX final clock rollback failed: %d\n", ret);
+	}
+	if (rx_priv->ssr_clock_owned) {
+		ret = lpass_cdc_clk_rsc_request_clock(rx_priv->dev,
+						      rx_priv->default_clk_id, RX_CORE_CLK, false);
+		if (!ret)
+			rx_priv->ssr_clock_owned = false;
+		else
+			dev_err(rx_priv->dev, "RX final SSR clock release failed: %d\n", ret);
+	}
+	if (voted)
+		lpass_cdc_rx_macro_core_vote(rx_priv, false);
+out:
+	mutex_unlock(&rx_priv->mclk_lock);
+}
