+static int lpass_cdc_rx_macro_notify_swr(struct lpass_cdc_rx_macro_priv *rx_priv,
+					 u32 event, void *data)
+{
+	struct platform_device *target;
+	int ret;
+
+	mutex_lock(&rx_priv->swr_ctrl_lock);
+	if (!rx_priv->swr_ctrl_data) {
+		mutex_unlock(&rx_priv->swr_ctrl_lock);
+		return 0;
+	}
+	if (rx_priv->swr_ctrl_users == UINT_MAX) {
+		mutex_unlock(&rx_priv->swr_ctrl_lock);
+		return -EOVERFLOW;
+	}
+	target = rx_priv->swr_ctrl_data[0].rx_swr_pdev;
+	rx_priv->swr_ctrl_users++;
+	mutex_unlock(&rx_priv->swr_ctrl_lock);
+	/* SoundWire can call back into the macro while handling a notification. */
+	ret = swrm_wcd_notify(target, event, data);
+	mutex_lock(&rx_priv->swr_ctrl_lock);
+	if (!--rx_priv->swr_ctrl_users)
+		wake_up_all(&rx_priv->swr_ctrl_wait);
+	mutex_unlock(&rx_priv->swr_ctrl_lock);
+	return ret;
+}
