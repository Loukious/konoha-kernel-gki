+		goto done;
 
 	if (adc->read_msg.status != SMB_ADC_READ_STATUS_SUCCESS) {
 		dev_err(adc->dev, "glink ADC read failed, bus_id=%u, pmic_id=%u, chan=%u, ret=%u\n",
@@ -183,6 +254,9 @@ static int glink_adc_fwnode_xlate(struct iio_dev *indio_dev,
 {
