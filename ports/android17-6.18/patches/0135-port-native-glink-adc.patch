+static void glink_adc_stop(struct glink_adc_dev *adc)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&adc->response_lock, flags);
+	adc->stopping = true;
+	if (adc->pending) {
+		adc->pending = false;
+		adc->result = -ENODEV;
+		complete(&adc->ack);
+	}
+	spin_unlock_irqrestore(&adc->response_lock, flags);
+}
+
+static void glink_adc_unregister_client(void *data)
+{
+	struct glink_adc_dev *adc = data;
+
+	glink_adc_stop(adc);
+	/* IIO publication is withdrawn first; drain writes before client free. */
+	mutex_lock(&adc->lock);
+	pmic_glink_unregister_client(adc->client);
+	mutex_unlock(&adc->lock);
+}
