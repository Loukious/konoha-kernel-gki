+static void glink_adc_state_callback(void *priv, enum pmic_glink_state state)
+{
+	struct glink_adc_dev *adc = priv;
+	unsigned long flags;
+
+	spin_lock_irqsave(&adc->response_lock, flags);
+	if (adc->stopping)
+		goto out;
+	adc->available = state == PMIC_GLINK_STATE_UP;
+	if (!adc->available) {
+		adc->down_seen = true;
+		if (adc->pending) {
+			adc->pending = false;
+			adc->result = -ENOTCONN;
+			complete(&adc->ack);
+		}
+	} else if (adc->down_seen) {
+		/* A new transport session follows provider RX-queue drainage. */
+		adc->desynced = false;
+		adc->down_seen = false;
+	}
+out:
+	spin_unlock_irqrestore(&adc->response_lock, flags);
+}
