@@ -578,6 +578,23 @@
 /* file operation function                                              */
 /* -------------------------------------------------------------------- */
 
+/* Called with fp_io_lock held, including legacy HAL enable without request. */
+static int fp_request_irq(struct fp_device *fp_dev)
+{
+	int ret;
+
+	if (fp_dev->irq_request)
+		return 0;
+	ret = request_threaded_irq(fp_dev->irq_num, NULL, fp_irq,
+				   IRQF_TRIGGER_RISING | IRQF_ONESHOT,
+				   "xiaomi_fp_irq", fp_dev);
+	if (ret)
+		return ret;
+	fp_dev->irq_request = true;
+	fp_dev->irq_enabled = true;
+	return 0;
+}
+
