+static void sih_ram_load(const struct firmware *cont, void *context)
+{
+	sih_haptic_t *sih_haptic = context;
+
+	if (READ_ONCE(sih_haptic->stopping))
+		release_firmware(cont);
+	else
+		sih_ram_load_data(cont, context);
+	if (atomic_dec_and_test(&sih_haptic->fw_refs))
+		wake_up_all(&sih_haptic->fw_wait);
+}
+
+static int sih_request_ram(sih_haptic_t *sih_haptic)
+{
+	int ret;
+
+	mutex_lock(&sih_haptic->fw_lock);
+	if (sih_haptic->stopping) {
+		mutex_unlock(&sih_haptic->fw_lock);
+		return -ENODEV;
+	}
+	atomic_inc(&sih_haptic->fw_refs);
+	ret = request_firmware_nowait(THIS_MODULE, FW_ACTION_UEVENT,
+				      awinic_ram_name[sih_haptic->ram.lib_index],
+				      sih_haptic->dev, GFP_KERNEL,
+				      sih_haptic, sih_ram_load);
+	if (ret && atomic_dec_and_test(&sih_haptic->fw_refs))
+		wake_up_all(&sih_haptic->fw_wait);
+	mutex_unlock(&sih_haptic->fw_lock);
+	return ret;
+}
