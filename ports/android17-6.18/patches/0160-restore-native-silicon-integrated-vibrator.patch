+static void sih_cleanup(sih_haptic_t *sih_haptic)
+{
+	mutex_lock(&sih_haptic->fw_lock);
+	WRITE_ONCE(sih_haptic->stopping, true);
+	mutex_unlock(&sih_haptic->fw_lock);
+	if (sih_haptic->sysfs_created) {
+		sysfs_remove_group(&sih_haptic->dev->kobj,
+				   &sih_vibra_attribute_group);
+		sih_haptic->sysfs_created = false;
+	}
+	mutex_lock(&sih_global_lock);
+	if (g_haptic_t.g_haptic[SIH_HAPTIC_MMAP_DEV_INDEX] == sih_haptic)
+		g_haptic_t.g_haptic[SIH_HAPTIC_MMAP_DEV_INDEX] = NULL;
+	mutex_unlock(&sih_global_lock);
+	if (sih_haptic->input_registered) {
+		input_unregister_device(sih_haptic->input_dev);
+		sih_haptic->input_registered = false;
+		sih_haptic->ff_created = false;
+	} else if (sih_haptic->ff_created) {
+		input_ff_destroy(sih_haptic->input_dev);
+		sih_haptic->ff_created = false;
+	}
+	if (sih_haptic->ring_owned)
+		rb_force_exit();
+	atomic_set(&sih_haptic->rtp.exit_in_rtp_loop, 1);
+	wake_up_interruptible(&sih_haptic->rtp.wait_q);
+	wake_up_interruptible(&sih_haptic->rtp.stop_wait_q);
+	if (sih_haptic->irq_requested) {
+		devm_free_irq(sih_haptic->dev,
+			      gpio_to_irq(sih_haptic->chip_attr.irq_gpio),
+			      sih_haptic);
+		sih_haptic->irq_requested = false;
+	}
+	wait_event(sih_haptic->fw_wait, !atomic_read(&sih_haptic->fw_refs));
+	hrtimer_cancel(&sih_haptic->timer);
+	if (sih_haptic->stream_initialized) {
+		sih_haptic->stream_func->stream_rtp_work_release(sih_haptic);
+		sih_haptic->stream_initialized = false;
+	}
+	cancel_work_sync(&sih_haptic->ram.gain_work);
+	cancel_work_sync(&sih_haptic->ram.ram_work);
+	cancel_work_sync(&sih_haptic->rtp.rtp_work);
+	if (sih_haptic->work_queue) {
+		destroy_workqueue(sih_haptic->work_queue);
+		sih_haptic->work_queue = NULL;
+	}
+	if (!IS_ERR_OR_NULL(sih_haptic->regmapp.regmapping) && sih_haptic->hp_func)
+		sih_haptic->hp_func->stop(sih_haptic);
+	pm_relax(sih_haptic->dev);
+	device_init_wakeup(sih_haptic->dev, false);
+	sih_vfree_container(sih_haptic, sih_haptic->rtp.rtp_cont);
+	sih_haptic->rtp.rtp_cont = NULL;
+	kfree(sih_haptic->chip_reg.reg_addr);
+	sih_haptic->chip_reg.reg_addr = NULL;
+	if (sih_haptic->ring_owned) {
+		release_rb();
+		sih_haptic->ring_owned = false;
+	}
 }
 
