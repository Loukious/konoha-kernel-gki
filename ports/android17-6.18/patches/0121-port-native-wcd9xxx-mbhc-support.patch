+static int audio_ext_clk_set_vote(struct audio_ext_clk_priv *clk_priv,
+				  bool enable)
+{
+#ifdef CONFIG_AUDIO_PRM
+	return audio_prm_set_lpass_clk_cfg(&clk_priv->prm_clk_cfg, enable);
+#else
+	return -EPERM;
+#endif
