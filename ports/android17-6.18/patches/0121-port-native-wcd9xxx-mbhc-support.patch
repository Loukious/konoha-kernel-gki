+static inline bool wcd_mbhc_is_started(const struct wcd_mbhc *mbhc)
+{
+	/* Pair with start publication before reading the callback configuration. */
+	return smp_load_acquire(&mbhc->mbhc_started);
+}
+
+static inline void wcd_mbhc_set_started(struct wcd_mbhc *mbhc, bool started)
+{
+	/* Publish the initialized configuration to IRQ and notifier callbacks. */
+	smp_store_release(&mbhc->mbhc_started, started);
+}
 
