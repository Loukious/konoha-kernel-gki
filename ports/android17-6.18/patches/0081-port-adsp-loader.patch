+/* Called with priv->lock held. Never consume another client's power vote. */
+static int adsp_loader_shutdown(struct adsp_loader_private *priv)
+{
+	int ret, error = 0;
+
+	if (priv->adsp_booted) {
+		ret = rproc_shutdown(priv->adsp);
+		if (!ret)
+			priv->adsp_booted = false;
+		else
+			error = ret;
+	}
+	if (priv->image_booted) {
+		ret = rproc_shutdown(priv->proc_image);
+		if (!ret)
+			priv->image_booted = false;
+		else if (!error)
+			error = ret;
+	}
+	return error;
+}
+
+/* A user-requested restart must also work for an automatically booted ADSP. */
+static int adsp_loader_restart(struct adsp_loader_private *priv)
+{
+	struct rproc *rproc = priv->adsp;
+	bool recovery_disabled;
+	int ret;
+
+	mutex_lock(&rproc->lock);
+	if (rproc->state != RPROC_RUNNING && rproc->state != RPROC_ATTACHED) {
+		ret = rproc->state == RPROC_OFFLINE ? -EAGAIN : -EBUSY;
+		mutex_unlock(&rproc->lock);
+		return ret;
+	}
+	recovery_disabled = rproc->recovery_disabled;
+	/* Explicit SSR temporarily permits core recovery without changing votes. */
+	rproc->recovery_disabled = false;
+	mutex_unlock(&rproc->lock);
+	rproc_report_crash(rproc, RPROC_FATAL_ERROR);
+	flush_work(&rproc->crash_handler);
+	mutex_lock(&rproc->lock);
+	/* Preserve a concurrent request to disable recovery. */
+	if (!rproc->recovery_disabled)
+		rproc->recovery_disabled = recovery_disabled;
+	ret = rproc->state == RPROC_RUNNING || rproc->state == RPROC_ATTACHED ?
+		0 : -EIO;
+	mutex_unlock(&rproc->lock);
+	return ret;
+}
