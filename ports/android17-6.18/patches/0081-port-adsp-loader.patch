+static ssize_t adsp_boot_store(struct kobject *kobj, struct kobj_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct adsp_loader_private *priv = adsp_loader_from_kobj(kobj);
+	int command, ret = 0;
+
+	if (kstrtoint(buf, 10, &command) ||
+	    (command != BOOT_CMD && command != IMAGE_UNLOAD_CMD))
+		return -EINVAL;
+	mutex_lock(&priv->commands);
+	if (READ_ONCE(priv->stopping)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (command == BOOT_CMD) {
+		schedule_work(&priv->work);
+	} else {
+		cancel_work_sync(&priv->work);
+		mutex_lock(&priv->lock);
+		priv->ssr_triggered = false;
+		ret = adsp_loader_shutdown(priv);
+		mutex_unlock(&priv->lock);
+	}
+unlock:
+	mutex_unlock(&priv->commands);
+	return ret ? ret : count;
+}
+
+static ssize_t adsp_ssr_store(struct kobject *kobj, struct kobj_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct adsp_loader_private *priv = adsp_loader_from_kobj(kobj);
+	int command, ret = 0;
+
+	if (kstrtoint(buf, 10, &command) || command != SSR_RESET_CMD)
+		return -EINVAL;
+	mutex_lock(&priv->commands);
+	if (READ_ONCE(priv->stopping)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	cancel_work_sync(&priv->work);
+	mutex_lock(&priv->lock);
+	priv->ssr_triggered = true;
+	mutex_unlock(&priv->lock);
+	schedule_work(&priv->work);
+unlock:
+	mutex_unlock(&priv->commands);
+	return ret ? ret : count;
+}
 
