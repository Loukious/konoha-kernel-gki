+static struct adsp_loader_private *adsp_loader_from_kobj(struct kobject *kobj)
+{
+	struct adsp_loader_sysfs *sysfs =
+		container_of(kobj, struct adsp_loader_sysfs, kobj);
+
+	return sysfs->priv;
+}
