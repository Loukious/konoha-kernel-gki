+static struct rproc *adsp_loader_get_rproc(struct device *dev,
+					   const char *property, bool optional)
+{
+	struct rproc *rproc;
+	u32 handle;
+	int ret;
+
+	if (!of_find_property(dev->of_node, property, NULL))
+		return optional ? NULL : ERR_PTR(-EINVAL);
+	ret = of_property_read_u32(dev->of_node, property, &handle);
+	if (ret || !handle)
+		return ERR_PTR(ret ? ret : -EINVAL);
+	rproc = rproc_get_by_phandle(handle);
+	if (!rproc)
+		return ERR_PTR(-EPROBE_DEFER);
+	return rproc;
+}
+
+static int adsp_loader_select_firmware(struct adsp_loader_private *priv)
+{
+	const char *names[MAX_FW_IMAGES], *name = NULL;
+	u32 bits[MAX_FW_IMAGES], variant = 0, unsupported = 0;
+	struct device_node *node = priv->dev->of_node;
+	struct nvmem_cell *cell;
+	size_t len;
+	void *buf;
+	int count, ret, i;
+
+	cell = nvmem_cell_get(priv->dev, "adsp_variant");
+	if (IS_ERR_OR_NULL(cell)) {
+		if (IS_ERR(cell) && PTR_ERR(cell) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		if (of_property_read_u32(node, "adsp-fuse-not-supported", &unsupported) ||
+		    !unsupported || of_property_read_string(node, "adsp-fw-name", &name))
+			return 0;
+		goto copy_name;
+	}
+	buf = nvmem_cell_read(cell, &len);
+	nvmem_cell_put(cell);
+	if (IS_ERR_OR_NULL(buf))
+		return IS_ERR(buf) && PTR_ERR(buf) == -EPROBE_DEFER ? -EPROBE_DEFER : 0;
+	if (!len || len > sizeof(variant)) {
+		kfree(buf);
+		return 0;
+	}
+	/* The native fuse value is a little-endian, zero-extended u32. */
+	memcpy(&variant, buf, len);
+	kfree(buf);
+	count = of_property_count_strings(node, "adsp-fw-names");
+	if (count <= 0 || count > MAX_FW_IMAGES)
+		return 0;
+	ret = of_property_read_u32_array(node, "adsp-fw-bit-values", bits, count);
+	if (ret)
+		return 0;
+	ret = of_property_read_string_array(node, "adsp-fw-names", names, count);
+	if (ret != count)
+		return 0;
+	for (i = 0; i < count; i++) {
+		if (bits[i] == variant) {
+			name = names[i];
+			break;
+		}
+	}
+	if (!name)
+		return 0;
+copy_name:
+	priv->adsp_fw_name = devm_kstrdup(priv->dev, name, GFP_KERNEL);
+	return priv->adsp_fw_name ? 0 : -ENOMEM;
+}
