+static void adsp_loader_remove(struct platform_device *pdev)
+{
+	struct adsp_loader_private *priv = platform_get_drvdata(pdev);
+	int ret;
+
+	mutex_lock(&priv->commands);
+	WRITE_ONCE(priv->stopping, true);
+	mutex_unlock(&priv->commands);
+	/* Removing the group drains active stores before private storage expires. */
+	sysfs_remove_group(&priv->sysfs->kobj, &adsp_loader_attr_group);
+	cancel_work_sync(&priv->work);
+	mutex_lock(&priv->lock);
+	ret = adsp_loader_shutdown(priv);
+	if (ret)
+		dev_err(priv->dev, "ADSP shutdown failed during removal: %d\n", ret);
+	mutex_unlock(&priv->lock);
+	kobject_put(&priv->sysfs->kobj);
+	adsp_loader_put_rprocs(priv);
+	platform_set_drvdata(pdev, NULL);
