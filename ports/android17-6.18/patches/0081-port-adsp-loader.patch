+static void adsp_load_fw(struct work_struct *work)
+{
+	struct adsp_loader_private *priv =
+		container_of(work, struct adsp_loader_private, work);
+	bool ssr, image_started = false;
+	u32 adsp_state = 0;
+	int ret;
+
+	mutex_lock(&priv->lock);
+	if (READ_ONCE(priv->stopping))
+		goto unlock;
+	ssr = priv->ssr_triggered;
+	priv->ssr_triggered = false;
+	if (ssr) {
+		ret = adsp_loader_restart(priv);
+		if (ret != -EAGAIN)
+			goto complete;
+	}
+	ret = of_property_read_u32(priv->dev->of_node, "qcom,adsp-state", &adsp_state);
+	if (ret && !ssr)
+		goto complete;
+	if (priv->proc_image && !strcmp(priv->proc_image->name, "modem") &&
+	    !adsp_state && !priv->image_booted) {
+		ret = rproc_boot(priv->proc_image);
+		if (ret)
+			goto complete;
+		priv->image_booted = true;
+		image_started = true;
+	}
+	if (priv->adsp_booted)
+		goto unlock;
+	if (spf_core_is_apm_ready(ADSP_LOADER_APM_TIMEOUT_MS))
+		goto unlock;
+	if (READ_ONCE(priv->stopping))
+		goto unlock;
+	if (priv->adsp_fw_name) {
+		ret = rproc_set_firmware(priv->adsp, priv->adsp_fw_name);
+		if (ret)
+			goto complete;
+	}
+	ret = rproc_boot(priv->adsp);
+	if (!ret)
+		priv->adsp_booted = true;
+complete:
+	if (ret) {
+		if (image_started && !rproc_shutdown(priv->proc_image))
+			priv->image_booted = false;
+		dev_err(priv->dev, "ADSP operation failed: %d\n", ret);
+	}
+unlock:
+	mutex_unlock(&priv->lock);
+}
