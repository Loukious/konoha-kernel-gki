+	misc_deregister(&aw8697_haptic_misc);
+	mutex_lock(&aw8697_misc_lock);
+	context = aw8697_misc_context;
+	aw8697_misc_context = NULL;
+	mutex_unlock(&aw8697_misc_lock);
+	mutex_lock(&context->lock);
+	context->aw8697 = NULL;
+	mutex_unlock(&context->lock);
+	kref_put(&context->ref, aw8697_misc_release);
+}
