+void aw86927_shutdown(struct aw86927 *aw86927)
+{
+	/* Publication and IRQ admission have been revoked by the caller. */
+	cancel_delayed_work_sync(&aw86927->ram_work);
+	hrtimer_cancel(&aw86927->timer);
+	hrtimer_cancel(&aw86927->stop_timer);
+	hrtimer_cancel(&aw86927->hap_disable_timer);
+	hrtimer_cancel(&aw86927->haptic_audio.timer);
+	cancel_work_sync(&aw86927->vibrator_work);
+	cancel_work_sync(&aw86927->rtp_work);
+	cancel_work_sync(&aw86927->set_gain_work);
+	cancel_work_sync(&aw86927->stop_work);
+	cancel_work_sync(&aw86927->haptic_audio.work);
+	/* A work item that was already running may have armed a final timer. */
+	hrtimer_cancel(&aw86927->timer);
+	hrtimer_cancel(&aw86927->stop_timer);
+	hrtimer_cancel(&aw86927->hap_disable_timer);
+	hrtimer_cancel(&aw86927->haptic_audio.timer);
+	destroy_workqueue(aw86927->work_queue);
+	aw86927->work_queue = NULL;
+	mutex_lock(&aw86927->lock);
+	aw86927_haptic_stop(aw86927);
+	mutex_unlock(&aw86927->lock);
+	pm_relax(aw86927->dev);
+	vfree(aw86927_rtp);
+	aw86927_rtp = NULL;
+}
