Subject: Release unpublished SND event client lists

Allow the machine driver to release an unpublished SND event client list
when master registration fails. Successful master registration keeps its
existing ownership contract.

---

--- a/qcom/opensource/audio-kernel/soc/snd_event.c
+++ b/qcom/opensource/audio-kernel/soc/snd_event.c
@@ -343,6 +343,16 @@
 }
 EXPORT_SYMBOL(snd_event_mstr_add_client);
 
+/* Free only an unpublished list; master registration takes ownership on success. */
+void snd_event_clients_free(struct snd_event_clients *clients)
+{
+	if (IS_ERR_OR_NULL(clients))
+		return;
+	kfree(clients->cl_arr);
+	kfree(clients);
+}
+EXPORT_SYMBOL(snd_event_clients_free);
+
 /*
  * snd_event_master_register - Register a master with the SND event FW
  *
--- a/qcom/opensource/audio-kernel/include/soc/snd_event.h
+++ b/qcom/opensource/audio-kernel/include/soc/snd_event.h
@@ -20,6 +20,7 @@
 };
 
 #ifdef CONFIG_SND_EVENT
+void snd_event_clients_free(struct snd_event_clients *clients);
 int snd_event_client_register(struct device *dev,
 			      const struct snd_event_ops *snd_ev_ops,
 			      void *data);
@@ -39,6 +40,10 @@
 	return 1;
 }
 #else
+static inline void snd_event_clients_free(struct snd_event_clients *clients)
+{
+}
+
 static inline int snd_event_client_register(struct device *dev,
 			      const struct snd_event_ops *snd_ev_ops,
 			      void *data)
