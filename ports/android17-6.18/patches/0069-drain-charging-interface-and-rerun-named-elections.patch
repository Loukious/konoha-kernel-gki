+void mca_charge_if_ops_unregister(const char *type_name, void *data)
+{
+	struct mca_charge_if_ops *entry;
+	int type;
+
+	if (!type_name || !data)
+		return;
+	type = mca_charge_if_get_op_type(type_name);
+	if (type < 0 || type >= MCA_CHARGE_IF_CHG_TYPE_ALL)
+		return;
+	mutex_lock(&charge_if_lock);
+	entry = rcu_dereference_protected(g_mca_charge_if_ops[type],
+					lockdep_is_held(&charge_if_lock));
+	if (!entry || entry->data != data) {
+		mutex_unlock(&charge_if_lock);
+		return;
+	}
+	rcu_assign_pointer(g_mca_charge_if_ops[type], NULL);
+	mutex_unlock(&charge_if_lock);
+	synchronize_srcu(&charge_if_srcu);
+	kfree(entry);
+}
+EXPORT_SYMBOL(mca_charge_if_ops_unregister);
 
