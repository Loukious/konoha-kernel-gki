Subject: [PATCH] iommu: arm-smmu: find probing devices during registration

Linux 6.18 probes IOMMU clients synchronously when a provider registers.
The driver-bound list cannot contain the provider until its probe returns,
so use the platform bus lookup matching the pinned upstream implementation.
Read driver data while retaining the device, clear publication on failed
probe, and retain the actual registration error in the diagnostic log.

---
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu.c b/drivers/iommu/arm/arm-smmu/arm-smmu.c
--- a/drivers/iommu/arm/arm-smmu/arm-smmu.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu.c
@@ -2498,10 +2498,11 @@
 static
 struct arm_smmu_device *arm_smmu_get_by_fwnode(struct fwnode_handle *fwnode)
 {
-	struct device *dev = driver_find_device_by_fwnode(&arm_smmu_driver.driver,
-							  fwnode);
+	struct device *dev = bus_find_device_by_fwnode(&platform_bus_type, fwnode);
+	struct arm_smmu_device *smmu = dev ? dev_get_drvdata(dev) : NULL;
+
 	put_device(dev);
-	return dev ? dev_get_drvdata(dev) : NULL;
+	return smmu;
 }
 
 static struct iommu_device *arm_smmu_probe_device(struct device *dev)
@@ -3770,7 +3771,7 @@
 
 	err = iommu_device_register(&smmu->iommu, &arm_smmu_ops.iommu_ops, dev);
 	if (err) {
-		dev_err(dev, "Failed to register iommu\n");
+		dev_err(dev, "Failed to register iommu: %d\n", err);
 		goto remove_iommu_sysfs_node;
 	}
 
@@ -3790,6 +3791,7 @@
 remove_iommu_sysfs_node:
 	iommu_device_sysfs_remove(&smmu->iommu);
 out_power_off:
+	platform_set_drvdata(pdev, NULL);
 	arm_smmu_power_off(smmu, smmu->pwr);
 	return err;
 }
