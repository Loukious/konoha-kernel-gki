+static void fp_cleanup(struct fp_device *fp_dev)
+{
+	if (fp_dev->sysfs_registered) {
+		sysfs_remove_group(&fp_dev->driver_device->dev.kobj, &attribute_group);
+		fp_dev->sysfs_registered = false;
+	}
+	if (fp_dev->cdev) {
+		if (fp_dev->cdev_registered)
+			cdev_del(fp_dev->cdev);
+		else
+			kobject_put(&fp_dev->cdev->kobj);
+		fp_dev->cdev = NULL;
+		fp_dev->cdev_registered = false;
+	}
+	if (fp_dev->fpid_cdev) {
+		if (fp_dev->id_cdev_registered)
+			cdev_del(fp_dev->fpid_cdev);
+		else
+			kobject_put(&fp_dev->fpid_cdev->kobj);
+		fp_dev->fpid_cdev = NULL;
+		fp_dev->id_cdev_registered = false;
+	}
+	if (fp_dev->irq_request) {
+		free_irq(fp_dev->irq_num, fp_dev);
+		fp_dev->irq_request = false;
+		fp_dev->irq_enabled = false;
+	}
+#ifndef XIAOMI_DRM_INTERFACE_WA
+	if (fp_dev->screen_state_wq) {
+		cancel_delayed_work_sync(&fp_dev->screen_state_dw);
+		destroy_workqueue(fp_dev->screen_state_wq);
+		fp_dev->screen_state_wq = NULL;
+	}
+	panel_event_notifier_unregister(cookie);
+	cookie = NULL;
+	prim_panel = NULL;
+#endif
+	fp_netlink_destroy(fp_dev);
+	WRITE_ONCE(fp_dev->fp_netlink_enabled, 0);
+	wakeup_source_unregister(fp_wakesrc);
+	fp_wakesrc = NULL;
+	fp_free_input_device();
+	if (fp_dev->listed) {
+		mutex_lock(&device_list_lock);
+		list_del_init(&fp_dev->device_entry);
+		mutex_unlock(&device_list_lock);
+		fp_dev->listed = false;
+	}
+	if (fp_dev->device) {
+		device_destroy(fp_dev->class, fp_dev->devt);
+		fp_dev->device = NULL;
+	}
+	if (fp_dev->id_device) {
+		device_destroy(fp_dev->class, MKDEV(MAJOR(fp_dev->devt), MINOR_NUM_MIFP_ID));
+		fp_dev->id_device = NULL;
+	}
+	if (fp_dev->region_registered) {
+		unregister_chrdev_region(fp_dev->devt, FP_MINOR_COUNT);
+		fp_dev->region_registered = false;
+	}
+	if (fp_dev->class) {
+		class_destroy(fp_dev->class);
+		fp_dev->class = NULL;
+	}
+	if (fp_power_off(&fp_dev->vreg_gpio))
+		dev_err(&fp_dev->driver_device->dev, "failed to disable fingerprint GPIO power\n");
+	if (fp_power_off(&fp_dev->vreg_1v8))
+		dev_err(&fp_dev->driver_device->dev, "failed to disable fingerprint 1.8V supply\n");
+	if (fp_power_off(&fp_dev->vreg_3v3))
+		dev_err(&fp_dev->driver_device->dev, "failed to disable fingerprint 3.3V supply\n");
+}
