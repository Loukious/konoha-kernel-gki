+	entry = kmalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return;
+	entry->ops = ops;
+	entry->data = data;
+	mutex_lock(&mca_charge_log_lock);
+	old = rcu_replace_pointer(g_mca_charge_log_data[type], entry,
