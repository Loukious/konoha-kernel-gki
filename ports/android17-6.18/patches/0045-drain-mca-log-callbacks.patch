+
+void mca_log_charge_log_unregister(enum mca_charge_log_id_ele type, void *data)
+{
+	struct mca_charge_log_ops_data *entry;
+
+	if ((unsigned int)type >= MCA_CHARGE_LOG_ID_MAX)
+		return;
+	mutex_lock(&mca_charge_log_lock);
+	entry = rcu_dereference_protected(g_mca_charge_log_data[type],
+					  lockdep_is_held(&mca_charge_log_lock));
+	if (!entry || entry->data != data) {
+		mutex_unlock(&mca_charge_log_lock);
+		return;
+	}
+	rcu_assign_pointer(g_mca_charge_log_data[type], NULL);
+	mutex_unlock(&mca_charge_log_lock);
+	synchronize_srcu(&mca_charge_log_srcu);
+	kfree(entry);
+}
+EXPORT_SYMBOL(mca_log_charge_log_unregister);
