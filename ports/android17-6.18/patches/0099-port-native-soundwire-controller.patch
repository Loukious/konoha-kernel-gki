+static void swrm_stop(struct swr_mstr_ctrl *swrm)
+{
+	unsigned long flags;
+
+	mutex_lock(&swrm_notify_lock);
+	WRITE_ONCE(swrm->stopping, true);
+	swrm->ready = false;
+	mutex_unlock(&swrm_notify_lock);
+	wait_event(swrm->notify_wait, !atomic_read(&swrm->notify_calls));
+#ifdef CONFIG_DEBUG_FS
+	debugfs_remove_recursive(swrm->debugfs_swrm_dent);
+	swrm->debugfs_swrm_dent = NULL;
+#endif
+	proc_remove(swrm->swr_mstr_ctrl_proc_entry);
+	swrm->swr_mstr_ctrl_proc_entry = NULL;
+	if (swrm->master_registered) {
+		/* Drain bus users while their completion IRQs are still available. */
+		spin_lock_irqsave(&swrm->master.state_lock, flags);
+		swrm->master.stopping = true;
+		spin_unlock_irqrestore(&swrm->master.state_lock, flags);
+		wait_event(swrm->master.call_wait,
+			   !atomic_read(&swrm->master.active_calls));
+	}
+	if (swrm->pm_enabled) {
+		pm_runtime_disable(swrm->dev);
+		swrm->pm_enabled = false;
+	}
+	if (swrm->irq_registered) {
+		if (swrm->irq_wake_enabled)
+			irq_set_irq_wake(swrm->irq, 0);
+		if (swrm->reg_irq)
+			swrm->reg_irq(swrm->handle, swr_mstr_interrupt,
+				      swrm, SWR_IRQ_FREE);
+		else
+			free_irq(swrm->irq, swrm);
+		swrm->irq_registered = false;
+	}
+	if (swrm->wake_irq_registered) {
+		if (swrm->wake_irq_enabled)
+			irq_set_irq_wake(swrm->wake_irq, 0);
+		free_irq(swrm->wake_irq, swrm);
+		swrm->wake_irq_registered = false;
+	}
+	cancel_work_sync(&swrm->wakeup_work);
+	cancel_work_sync(&swrm->dc_presence_work);
+	/* No callback, IRQ, work or PM user can re-enable the hardware now. */
+	if (swrm->clk_ref_count > 0) {
+		swr_master_write(swrm, SWRM_INTERRUPT_EN(swrm->ee_val), 0);
+		swr_master_write(swrm, SWRM_COMP_CFG, 0);
+	}
+	while (swrm->clk_ref_count > 0)
+		swrm_clk_request(swrm, false);
+	while (swrm->aud_core_clk_en > 0)
+		swrm_request_hw_vote(swrm, LPASS_AUDIO_CORE, false);
+	while (swrm->hw_core_clk_en > 0)
+		swrm_request_hw_vote(swrm, LPASS_HW_CORE, false);
+	device_init_wakeup(swrm->dev, false);
