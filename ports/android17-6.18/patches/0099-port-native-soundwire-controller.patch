+static void swrm_free(struct kref *ref)
+{
+	struct swr_mstr_ctrl *swrm = container_of(ref, struct swr_mstr_ctrl, refs);
+
+	kfree(swrm);
+}
+
+static void swrm_master_release(struct swr_master *master)
+{
+	struct swr_mstr_ctrl *swrm = swr_get_ctrl_data(master);
+
+	/* The platform reference remains until this completion is observed. */
+	kref_put(&swrm->refs, swrm_free);
+	complete(&swrm->master_released);
+}
+
+static void swrm_drop_platform(struct swr_mstr_ctrl *swrm)
+{
+	mutex_lock(&swrm_notify_lock);
+	platform_set_drvdata(swrm->pdev, NULL);
+	mutex_unlock(&swrm_notify_lock);
+	kref_put(&swrm->refs, swrm_free);
+}
+
+static void swrm_free_port_requests(struct swr_mstr_ctrl *swrm)
+{
+	struct swr_port_info *req, *next;
+	int i;
+
+	for (i = 0; i < SWR_MSTR_PORT_LEN; i++) {
+		list_for_each_entry_safe(req, next,
+					 &swrm->mport_cfg[i].port_req_list, list) {
+			list_del(&req->list);
+			kfree(req);
+		}
+	}
+}
