 static struct list_head cam_req_mgr_ordered_sd_list;
 
+static DEFINE_MUTEX(cam_node_lock);
+static DECLARE_WAIT_QUEUE_HEAD(cam_node_wait);
+static DECLARE_COMPLETION(cam_v4l2_released);
+static unsigned int cam_node_users;
+static bool cam_nodes_ready;
+static bool cam_v4l2_ref_held;
+static bool cam_subdev_nodes_live;
+
+int cam_req_mgr_get_node(void)
+{
+	int rc = 0;
+
+	mutex_lock(&cam_node_lock);
+	if (!cam_nodes_ready)
+		rc = -ENODEV;
+	else
+		WRITE_ONCE(cam_node_users, cam_node_users + 1);
+	mutex_unlock(&cam_node_lock);
+	return rc;
+}
+
+void cam_req_mgr_put_node(void)
+{
+	mutex_lock(&cam_node_lock);
+	if (WARN_ON(!cam_node_users)) {
+		mutex_unlock(&cam_node_lock);
+		return;
+	}
+	WRITE_ONCE(cam_node_users, cam_node_users - 1);
+	if (!cam_node_users)
+		wake_up_all(&cam_node_wait);
+	mutex_unlock(&cam_node_lock);
+}
+
+static void cam_v4l2_device_released(struct v4l2_device *v4l2_dev)
+{
+	/* The master keeps storage until all child teardown has completed. */
+	complete(&cam_v4l2_released);
+}
+
+static int cam_subdev_open_tracked(struct v4l2_subdev *sd,
+	struct v4l2_subdev_fh *fh)
+{
+	struct cam_subdev *csd = container_of(sd, struct cam_subdev, sd);
+	int rc = cam_req_mgr_get_node();
+
+	if (rc)
+		return rc;
+	if (csd->internal_ops && csd->internal_ops->open)
+		rc = csd->internal_ops->open(sd, fh);
+	if (rc < 0)
+		cam_req_mgr_put_node();
+	return rc;
+}
+
+static int cam_subdev_close_tracked(struct v4l2_subdev *sd,
+	struct v4l2_subdev_fh *fh)
+{
+	struct cam_subdev *csd = container_of(sd, struct cam_subdev, sd);
+	int rc = 0;
+
+	if (csd->internal_ops && csd->internal_ops->close)
+		rc = csd->internal_ops->close(sd, fh);
+	cam_req_mgr_put_node();
+	return rc;
+}
+
+static void cam_req_mgr_drain_nodes(void)
+{
+	struct cam_subdev *csd;
+
+	mutex_lock(&cam_node_lock);
+	cam_nodes_ready = false;
+	mutex_unlock(&cam_node_lock);
+	wait_event(cam_node_wait, !READ_ONCE(cam_node_users));
+
+	/* Keep sd->v4l2_dev and child storage valid for rejected opens too. */
+	if (cam_subdev_nodes_live) {
+		cam_subdev_nodes_live = false;
+		list_for_each_entry(csd, &cam_req_mgr_ordered_sd_list, list) {
+			if (csd->sd.devnode)
+				video_unregister_device(csd->sd.devnode);
+		}
+	}
+	if (g_dev.video)
+		video_unregister_device(g_dev.video);
+	if (cam_v4l2_ref_held) {
+		cam_v4l2_ref_held = false;
+		v4l2_device_put(g_dev.v4l2_dev);
+		/* Last video release finishes its subdevice writes before this. */
+		wait_for_completion(&cam_v4l2_released);
+	}
+}
