-				u32 *val, unsigned int length)
+static int swr_master_bulk_write_locked(struct swr_mstr_ctrl *swrm, u32 *reg_addr,
+					u32 *val, unsigned int length)
 {
 	int i = 0;
 
+	lockdep_assert_held(&swrm->iolock);
 	if (swrm->bulk_write)
-		swrm->bulk_write(swrm->handle, reg_addr, val, length);
+		return swrm->bulk_write(swrm->handle, reg_addr, val, length);
