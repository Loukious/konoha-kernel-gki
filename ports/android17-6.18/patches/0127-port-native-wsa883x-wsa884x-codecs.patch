+/* Called by the driver core with probe/remove serialized, never from an IRQ. */
+static int wsa883x_swr_cleanup(struct wsa883x_priv *wsa883x)
+{
+	int irq, ret;
+
+	if (wsa883x->notifier_registered) {
+		ret = wsa883x->register_notifier(wsa883x->handle,
+					  &wsa883x->parent_nblock, false);
+		if (ret)
+			return ret;
+		wsa883x->notifier_registered = false;
+	}
+	if (wsa883x->irq_published) {
+		/* Withdrawal waits for dispatch without holding handler locks. */
+		ret = swr_set_slave_irq(wsa883x->swr_slave, NULL);
+		if (ret)
+			return ret;
+		wsa883x->irq_published = false;
+	}
+	proc_remove(wsa883x->wsa883x_proc_entry);
+	wsa883x->wsa883x_proc_entry = NULL;
+#ifdef CONFIG_DEBUG_FS
+	debugfs_remove_recursive(wsa883x->debugfs_dent);
+	wsa883x->debugfs_dent = NULL;
+#endif
+	if (wsa883x->component_registered) {
+		snd_soc_unregister_component(wsa883x->dev);
+		wsa883x->component_registered = false;
+	}
+	for (irq = WSA883X_NUM_IRQS - 1; irq >= 0; irq--) {
+		if (test_and_clear_bit(irq, &wsa883x->requested_irqs))
+			wcd_free_irq(&wsa883x->irq_info, irq, wsa883x);
+	}
+	if (wsa883x->virq) {
+		wcd_irq_exit(&wsa883x->irq_info, wsa883x->virq);
+		wsa883x->virq = NULL;
+	}
+	if (wsa883x->reset_active && !wsa883x->reset_was_active)
+		wsa883x_gpio_ctrl(wsa883x, false);
+	if (wsa883x->supplies_initialized)
+		msm_cdc_release_supplies(wsa883x->dev, wsa883x->supplies,
+					 wsa883x->regulator, wsa883x->num_supplies);
+	if (wsa883x->parent_dev)
+		put_device(&wsa883x->parent_dev->dev);
+	of_node_put(wsa883x->parent_np);
+	of_node_put(wsa883x->wsa_rst_np);
+	swr_set_dev_data(wsa883x->swr_slave, NULL);
+	mutex_destroy(&wsa883x->res_lock);
+	return 0;
+}
 
