+static bool msm_pcie_span_valid(u64 span, u64 offset, u64 len)
+{
+	return IS_ALIGNED(offset, sizeof(u32)) && offset <= span &&
+	       len <= span - offset;
+}
+
+static bool msm_pcie_reg_valid(struct msm_pcie_dev_t *dev, unsigned int idx,
+			       u64 offset, u64 len)
+{
+	struct msm_pcie_res_info_t *res;
+
+	if (idx >= MSM_PCIE_MAX_RES)
+		return false;
+	res = &dev->res[idx];
+	return res->base && res->resource &&
+	       msm_pcie_span_valid(resource_size(res->resource), offset, len);
+}
+
+static int msm_pcie_validate_offsets(struct msm_pcie_dev_t *dev, unsigned int idx,
+				     const u32 *offsets, unsigned int count)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++)
+		if (!msm_pcie_reg_valid(dev, idx, offsets[i], sizeof(u32)))
+			return -EINVAL;
+	return 0;
+}
+
+static bool msm_pcie_config_valid(int where, int size, u64 span)
+{
+	return (size == 1 || size == 2 || size == 4) && where >= 0 &&
+	       !(where & (size - 1)) && where <= PCI_CFG_SPACE_EXP_SIZE - size &&
+	       msm_pcie_span_valid(span, where & ~3, sizeof(u32));
+}
