+static void lpass_cdc_wsa_macro_remove_child_devices(struct lpass_cdc_wsa_macro_priv *wsa_priv)
+{
+	struct lpass_cdc_wsa_macro_swr_ctrl_data *controllers;
+	struct platform_device *child;
+
+	mutex_lock(&wsa_priv->swr_ctrl_lock);
+	controllers = wsa_priv->swr_ctrl_data;
+	wsa_priv->swr_ctrl_data = NULL;
+	mutex_unlock(&wsa_priv->swr_ctrl_lock);
+	wait_event(wsa_priv->swr_ctrl_wait, !READ_ONCE(wsa_priv->swr_ctrl_users));
+	/* Wait for the last notifier to finish its unlock tail. */
+	mutex_lock(&wsa_priv->swr_ctrl_lock);
+	mutex_unlock(&wsa_priv->swr_ctrl_lock);
+	while (wsa_priv->child_count) {
+		child = wsa_priv->pdev_child_devices[--wsa_priv->child_count];
+		wsa_priv->pdev_child_devices[wsa_priv->child_count] = NULL;
+		platform_device_unregister(child);
+	}
+	kfree(controllers);
+}
