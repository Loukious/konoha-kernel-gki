+static int lpass_cdc_wsa_macro_notify_swr(struct lpass_cdc_wsa_macro_priv *wsa_priv,
+					  u32 event, void *data)
+{
+	struct platform_device *target;
+	int ret;
+
+	mutex_lock(&wsa_priv->swr_ctrl_lock);
+	if (!wsa_priv->swr_ctrl_data) {
+		mutex_unlock(&wsa_priv->swr_ctrl_lock);
+		return 0;
+	}
+	if (wsa_priv->swr_ctrl_users == UINT_MAX) {
+		mutex_unlock(&wsa_priv->swr_ctrl_lock);
+		return -EOVERFLOW;
+	}
+	target = wsa_priv->swr_ctrl_data[0].wsa_swr_pdev;
+	wsa_priv->swr_ctrl_users++;
+	mutex_unlock(&wsa_priv->swr_ctrl_lock);
+	/* Controller callbacks may reenter this macro. */
+	ret = swrm_wcd_notify(target, event, data);
+	mutex_lock(&wsa_priv->swr_ctrl_lock);
+	if (!--wsa_priv->swr_ctrl_users)
+		wake_up_all(&wsa_priv->swr_ctrl_wait);
+	mutex_unlock(&wsa_priv->swr_ctrl_lock);
+	return ret;
+}
