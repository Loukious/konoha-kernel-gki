+};
+
+static void fastrpc_genpool_release(void *data)
+{
+	struct fastrpc_cb_resource *res = data;
+
+	if (res->mapped)
+		iommu_unmap(res->domain, res->iova, res->mapped);
+	if (res->buf.virt)
+		dma_free_coherent(res->dev, res->buf.size, res->buf.virt, res->buf.phys);
+}
+
+static int fastrpc_genpool_create(struct fastrpc_cb_resource *res,
+				  struct gen_pool **result)
+{
+	struct device *dev = res->dev;
+	struct gen_pool *pool;
+	struct sg_table sgt;
+	u32 range[2];
+	int err;
+	ssize_t mapped;
+
+	err = of_property_read_u32_array(dev->of_node, "frpc-gen-addr-pool",
+					 range, ARRAY_SIZE(range));
+	if (err)
+		return err;
+	if (!range[1] || !PAGE_ALIGNED(range[0]) || !PAGE_ALIGNED(range[1]) ||
+	    (u64)range[0] + range[1] > SMMU_4GB_ADDRESS_SPACE)
+		return -EINVAL;
+	res->iova = range[0];
+	res->buf.size = range[1];
+	res->buf.dev = dev;
+	/* Registered first: the later managed pool is destroyed before its backing. */
+	err = devm_add_action_or_reset(dev, fastrpc_genpool_release, res);
+	if (err)
+		return err;
+	res->buf.virt = dma_alloc_coherent(dev, res->buf.size,
+					 (dma_addr_t *)&res->buf.phys, GFP_KERNEL);
+	if (!res->buf.virt)
+		return -ENOMEM;
+	err = dma_get_sgtable(dev, &sgt, res->buf.virt, res->buf.phys, res->buf.size);
+	if (err)
+		return err;
+	res->domain = iommu_get_domain_for_dev(dev);
+	if (!res->domain) {
+		sg_free_table(&sgt);
+		return -ENODEV;
+	}
+	mapped = iommu_map_sg(res->domain, res->iova, sgt.sgl,
+				  sgt.orig_nents, IOMMU_READ | IOMMU_WRITE | IOMMU_CACHE,
+				  GFP_KERNEL);
+	sg_free_table(&sgt);
+	if (mapped < 0)
+		return mapped;
+	res->mapped = mapped;
+	if (res->mapped != res->buf.size)
+		return -EIO;
+	pool = devm_gen_pool_create(dev, 0, NUMA_NO_NODE, NULL);
+	if (IS_ERR(pool))
+		return PTR_ERR(pool);
+	err = gen_pool_add_virt(pool, (unsigned long)res->buf.virt,
+				res->buf.phys, res->buf.size, NUMA_NO_NODE);
+	if (err)
+		return err;
+	*result = pool;
+	return 0;
+}
