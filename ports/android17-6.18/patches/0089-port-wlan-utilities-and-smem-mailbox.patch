+static int mailbox_indices(void __iomem *ring, u32 size, u32 *head, u32 *tail)
+{
+	*head = readl(ring);
+	*tail = readl(ring + sizeof(u32));
+	if (*head >= size || *tail >= size || (*head & 3) || (*tail & 3))
+		return -EPROTO;
+	/* The peer publishes its head after writing the payload. */
+	rmb();
+	return 0;
+}
