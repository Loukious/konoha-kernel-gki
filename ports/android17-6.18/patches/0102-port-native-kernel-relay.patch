+
+/* The stock GKI did not compile its fixed CPUHP_RELAY_PREPARE callback. */
+static int relay_hp_state;
+
+static int __init onyx_relay_init(void)
+{
+	relay_hp_state = cpuhp_setup_state(CPUHP_BP_PREPARE_DYN,
+					   "onyx/relay:prepare", relay_prepare_cpu, NULL);
+	return relay_hp_state < 0 ? relay_hp_state : 0;
+}
+
+static void __exit onyx_relay_exit(void)
+{
+	cpuhp_remove_state(relay_hp_state);
+}
+
+module_init(onyx_relay_init);
+module_exit(onyx_relay_exit);
+MODULE_DESCRIPTION("Onyx native relay provider for the stock GKI");
+MODULE_LICENSE("GPL");
