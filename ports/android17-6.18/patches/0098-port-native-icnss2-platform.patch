+static int icnss_publish_fault_handler(struct icnss_priv *priv)
+{
+	int ret;
+
+	if (!priv->smmu_s1_enable)
+		return 0;
+	if (priv->device_id == WCN7750_DEVICE_ID) {
+		ret = icnss_register_iommu_fault_handler_irq(priv);
+		if (ret)
