+static void btpower_send_signal(struct platform_pwr_data *pdata, bool bluetooth,
+				int signal_state)
+{
+	struct kernel_siginfo siginfo = { .si_signo = SIGIO, .si_code = SI_QUEUE };
+	struct task_struct *task;
+	unsigned long flags;
+
+	spin_lock_irqsave(&pdata->task_lock, flags);
+	task = bluetooth ? pdata->reftask_bt : pdata->reftask_uwb;
+	if (task)
+		get_task_struct(task);
+	spin_unlock_irqrestore(&pdata->task_lock, flags);
+	siginfo.si_int = signal_state;
+	if (task) {
+		send_sig_info(SIGIO, &siginfo, task);
+		put_task_struct(task);
+	}
+}
+
+static void bt_signal_handler(struct work_struct *work)
+{
+	struct platform_pwr_data *pdata = container_of(work, struct platform_pwr_data, bt_wq);
+
+	btpower_send_signal(pdata, true, READ_ONCE(pdata->wrkq_signal_state));
+}
