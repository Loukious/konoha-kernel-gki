+	    (unsigned long)file->private_data == btpower_generation) {
+		mutex_lock(&btpower_ioctl_lock);
+		if (!queued)
+			mutex_lock(&btpower_operation_lock);
+		ret = bt_ioctl_dispatch(file, cmd, arg);
+		if (!queued)
+			mutex_unlock(&btpower_operation_lock);
+		mutex_unlock(&btpower_ioctl_lock);
+	}
+	srcu_read_unlock(&btpower_srcu, idx);
+	return ret;
