+/* RX pipes must be quiesced and the netdev unpublished before this call. */
+static void ipa3_wwan_napi_del(struct net_device *dev)
+{
+	struct ipa3_wwan_private *wwan_ptr = netdev_priv(dev);
+
+	if (!ipa3_rmnet_res.ipa_napi_enable)
+		return;
+
+	if (ipa3_ctx->rmnet_napi_enable) {
+		napi_disable(&wwan_ptr->napi);
+		ipa3_ctx->rmnet_napi_enable = false;
+	}
+	netif_napi_del(&wwan_ptr->napi);
+}
