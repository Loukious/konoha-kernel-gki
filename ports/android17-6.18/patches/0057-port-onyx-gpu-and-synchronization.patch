+	child = kzalloc(sizeof(*child), GFP_KERNEL);
+	if (!child)
+		return ERR_PTR(-ENOMEM);
+	init_completion(&child->released);
+	dev = &child->dev;
+	device_initialize(dev);
+	dev->parent = parent;
+	dev->of_node = of_node_get(node);
+	dev->release = ipclite_device_release;
+	ret = dev_set_name(dev, "%s:%pOFn", dev_name(parent->parent), node);
+	if (!ret)
