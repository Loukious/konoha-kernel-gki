+static void swrm_handle_nested_irq(struct irq_domain *domain)
+{
+	unsigned int virq = irq_find_mapping(domain, 0);
+
+	if (virq)
+		handle_nested_irq(virq);
+}
+
+static void swrm_dispatch_slave_irq(struct swr_mstr_ctrl *swrm, u8 devnum)
+{
+	bool pending;
+
+	do {
+		pending = swr_handle_slave_irq(&swrm->master, devnum,
+					       swrm_handle_nested_irq);
+	} while (pending && READ_ONCE(swrm->dev_up));
+}
