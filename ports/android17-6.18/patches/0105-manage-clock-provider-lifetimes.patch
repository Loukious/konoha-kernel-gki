+
+int qcom_cc_register_rcg_dfs_managed(struct device *dev,
+				   const struct qcom_cc_desc *desc,
+				   struct regmap *regmap,
+				   const struct clk_rcg_dfs_data *rcgs,
+				   size_t len)
+{
+	struct clk_rcg_dfs_owner *owner;
+	size_t i;
+	int ret;
+
+	ret = qcom_cc_prepare(dev, desc);
+	if (ret)
+		return ret;
+	owner = devm_kzalloc(dev, struct_size(owner, saved, len), GFP_KERNEL);
+	if (!owner)
+		return -ENOMEM;
+	owner->dev = dev;
+	owner->num = len;
+	for (i = 0; i < len; i++) {
+		owner->saved[i].data = &rcgs[i];
+		owner->saved[i].init = *rcgs[i].init;
+		owner->saved[i].freq_tbl = rcgs[i].rcg->freq_tbl;
+		owner->saved[i].flags = rcgs[i].rcg->flags;
+	}
+	/* CCF unregister/terminate runs before these static templates are restored. */
+	ret = devm_add_action_or_reset(dev, clk_rcg_dfs_restore, owner);
+	if (ret)
+		return ret;
+	return qcom_cc_register_rcg_dfs(regmap, rcgs, len);
+}
