+static void clk_rcg_dfs_restore(void *data)
+{
+	struct clk_rcg_dfs_owner *owner = data;
+	struct clk_rcg_dfs_saved *saved;
+	size_t i;
+
+	if (!qcom_cc_can_restore(owner->dev))
+		return;
+	for (i = 0; i < owner->num; i++) {
+		saved = &owner->saved[i];
+		*saved->data->init = saved->init;
+		saved->data->rcg->freq_tbl = saved->freq_tbl;
+		saved->data->rcg->flags = saved->flags;
+	}
