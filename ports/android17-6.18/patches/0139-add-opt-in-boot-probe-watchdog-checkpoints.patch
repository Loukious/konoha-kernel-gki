+++ b/qcom/opensource/dataipa/drivers/platform/msm/ipa/ipa_v3/ipa.c
@@ -55,6 +55,16 @@
 #define __cpuc_flush_dcache_area __flush_dcache_area
 
 #endif
+
+static bool boot_trace;
+module_param(boot_trace, bool, 0400);
+MODULE_PARM_DESC(boot_trace, "Log boot initialization checkpoints");
+
+static void ipa_boot_checkpoint(struct device *dev, const char *stage, int ret)
+{
+	if (boot_trace)
+		dev_info(dev, "Konoha boot: %s ret=%d\n", stage, ret);
+}
 
 #define DRV_NAME "ipa"
 #define DELAY_BEFORE_FW_LOAD 500
@@ -11764,7 +11774,7 @@
 	return 0;
 }
 
-int ipa3_plat_drv_probe(struct platform_device *pdev_p)
+static int ipa3_plat_drv_probe_impl(struct platform_device *pdev_p)
 {
 	int result;
 	struct device *dev = &pdev_p->dev;
@@ -11898,7 +11908,9 @@
 	    "qcom,smp2p-map-ipa-1-in"))
 		return ipa3_smp2p_probe(dev);
 
+	ipa_boot_checkpoint(dev, "ipa.dts.enter", 0);
 	result = get_ipa_dts_configuration(pdev_p, &ipa3_res);
+	ipa_boot_checkpoint(dev, "ipa.dts.exit", result);
 	if (result) {
 		IPAERR("IPA dts parsing failed\n");
 		return result;
@@ -11910,6 +11922,7 @@
 	* functions, that deal with the transport, require the
 	* access.
 	*/
+	ipa_boot_checkpoint(dev, "ipa.gsi-map.enter", 0);
 	if (gsi_map_base(
 		ipa3_res.transport_mem_base,
 		ipa3_res.transport_mem_size,
@@ -11917,6 +11930,8 @@
 		IPAERR("Allocation of gsi base failed\n");
 		return -EFAULT;
 	}
+
+	ipa_boot_checkpoint(dev, "ipa.gsi-map.exit", 0);
 
 	/* Get GSI version */
 	ipa3_ctx->gsi_ver = ipa3_get_gsi_ver(ipa3_res.ipa_hw_type);
@@ -11948,7 +11963,9 @@
 		 * existing flow initialzies only for smmu
 		 * enabled node.*/
 
+		ipa_boot_checkpoint(dev, "ipa.pre-init.enter", 0);
 		result = ipa3_pre_init(&ipa3_res, pdev_p);
+		ipa_boot_checkpoint(dev, "ipa.pre-init.exit", result);
 		if (result) {
 			IPAERR("ipa3_init failed\n");
 			return result;
@@ -11958,15 +11975,19 @@
 	}
 
 	/* Proceed to real initialization */
+	ipa_boot_checkpoint(dev, "ipa.pre-init.enter", 0);
 	result = ipa3_pre_init(&ipa3_res, pdev_p);
+	ipa_boot_checkpoint(dev, "ipa.pre-init.exit", result);
 	if (result) {
 		IPAERR("ipa3_init failed\n");
 		return result;
 	}
 
 skip_repeat_pre_init:
+	ipa_boot_checkpoint(dev, "ipa.populate.enter", 0);
 	result = of_platform_populate(pdev_p->dev.of_node,
 		ipa_plat_drv_match, NULL, &pdev_p->dev);
+	ipa_boot_checkpoint(dev, "ipa.populate.exit", result);
 	if (result) {
 		IPAERR("failed to populate platform\n");
 		return result;
@@ -11976,6 +11997,16 @@
 		IPAERR("ipa: ipa_plat_drv_probe failed\n");
 
 	return result;
+}
+
+int ipa3_plat_drv_probe(struct platform_device *pdev_p)
+{
+	int ret;
+
+	ipa_boot_checkpoint(&pdev_p->dev, "ipa.probe.enter", 0);
+	ret = ipa3_plat_drv_probe_impl(pdev_p);
+	ipa_boot_checkpoint(&pdev_p->dev, "ipa.probe.exit", ret);
+	return ret;
 }
 
