Subject: [PATCH] qcom: add opt-in boot probe and watchdog checkpoints

Gate labelled probe entry/exit and initialization-stage records behind
read-only boot_trace module parameters, disabled by default. Record I2C
adapter/client registration, IPA device setup and watchdog timer/IPI/pet
progress without changing timeouts, hardware calls or probe results.
The diagnostic image selects these parameters and GKI lockup reporting.

---
diff --git a/drivers/i2c/busses/i2c-msm-geni.c b/drivers/i2c/busses/i2c-msm-geni.c
--- a/drivers/i2c/busses/i2c-msm-geni.c
+++ b/drivers/i2c/busses/i2c-msm-geni.c
@@ -26,6 +26,16 @@
 #include <linux/pinctrl/consumer.h>
 #include <linux/sched/clock.h>
 #include <linux/slab.h>
+
+static bool boot_trace;
+module_param(boot_trace, bool, 0400);
+MODULE_PARM_DESC(boot_trace, "Log boot initialization checkpoints");
+
+static void geni_i2c_boot_checkpoint(struct device *dev, const char *stage, int ret)
+{
+	if (boot_trace)
+		dev_info(dev, "Konoha boot: %s ret=%d\n", stage, ret);
+}
 
 #define SE_GENI_TEST_BUS_CTRL	0x44
 #define SE_NUM_FOR_TEST_BUS	5
@@ -2985,7 +2995,8 @@
 
 	return 0;
 }
-static int geni_i2c_probe(struct platform_device *pdev)
+
+static int geni_i2c_probe_impl(struct platform_device *pdev)
 {
 	struct geni_i2c_dev *gi2c;
 	struct resource *res;
@@ -3062,7 +3073,9 @@
 	 * se irq not required. Below properties will not be present
 	 * in I2C LE dt.
 	 */
+	geni_i2c_boot_checkpoint(dev, "i2c.resources-init.enter", 0);
 	ret = geni_i2c_resources_init(pdev, gi2c);
+	geni_i2c_boot_checkpoint(dev, "i2c.resources-init.exit", ret);
 	if (ret)
 		return ret;
 
@@ -3121,7 +3134,9 @@
 	gi2c->ipc_log_kpi = ipc_log_context_create(IPC_LOG_KPI_PAGES, ipc_name, 0);
 	atomic_set(&gi2c->is_xfer_in_progress, 0);
 	pm_runtime_enable(gi2c->dev);
+	geni_i2c_boot_checkpoint(dev, "i2c.adapter-add.enter", 0);
 	ret = i2c_add_adapter(&gi2c->adap);
+	geni_i2c_boot_checkpoint(dev, "i2c.adapter-add.exit", ret);
 	if (ret) {
 		dev_err(gi2c->dev, "Add adapter failed, ret=%d\n", ret);
 		pm_runtime_disable(gi2c->dev);
@@ -3140,6 +3155,16 @@
 	pr_info("boot_kpi: M - DRIVER GENI_I2C_%d Ready\n", gi2c->adap.nr);
 	dev_info(gi2c->dev, "I2C probed\n");
 	return 0;
+}
+
+static int geni_i2c_probe(struct platform_device *pdev)
+{
+	int ret;
+
+	geni_i2c_boot_checkpoint(&pdev->dev, "i2c.probe.enter", 0);
+	ret = geni_i2c_probe_impl(pdev);
+	geni_i2c_boot_checkpoint(&pdev->dev, "i2c.probe.exit", ret);
+	return ret;
 }
 
 static void geni_i2c_remove(struct platform_device *pdev)
