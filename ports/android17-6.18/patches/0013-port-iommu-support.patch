+/* 6.18 IOPF handles page requests, not unrecoverable device faults. */
+struct qcom_iommu_device_fault_handler {
+	struct device *dev;
+	qcom_iommu_device_fault_handler_t handler;
+	void *data;
+	struct mutex lock; /* Serializes callbacks for this device. */
+};
