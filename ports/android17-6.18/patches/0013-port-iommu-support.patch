+static DEFINE_XARRAY(qcom_iommu_device_faults);
+DEFINE_STATIC_SRCU(qcom_iommu_device_fault_srcu);
+
+int qcom_iommu_register_device_fault_handler(struct device *dev,
+					     qcom_iommu_device_fault_handler_t handler, void *data)
+{
+	struct qcom_iommu_device_fault_handler *entry;
+	int ret;
+
+	if (!dev || !dev->iommu || !handler)
+		return -EINVAL;
+
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+
+	entry->dev = get_device(dev);
+	entry->handler = handler;
+	entry->data = data;
+	mutex_init(&entry->lock);
+	ret = xa_insert(&qcom_iommu_device_faults, (unsigned long)dev,
+			entry, GFP_KERNEL);
+	if (ret) {
+		put_device(entry->dev);
+		kfree(entry);
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_iommu_register_device_fault_handler);
+
+/* Clients must unregister outside their callback before releasing its data. */
+int qcom_iommu_unregister_device_fault_handler(struct device *dev)
+{
+	struct qcom_iommu_device_fault_handler *entry;
+
+	if (!dev)
+		return -EINVAL;
+
+	entry = xa_erase(&qcom_iommu_device_faults, (unsigned long)dev);
+	if (!entry)
+		return 0;
+
+	synchronize_srcu(&qcom_iommu_device_fault_srcu);
+	put_device(entry->dev);
+	kfree(entry);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_iommu_unregister_device_fault_handler);
+
+int qcom_iommu_report_device_fault(struct device *dev, struct qcom_iommu_fault *fault)
+{
+	struct qcom_iommu_device_fault_handler *entry;
+	int idx, ret = -ENODEV;
+
+	if (!dev || !fault || fault->type != QCOM_IOMMU_FAULT_DMA_UNRECOV)
+		return -EINVAL;
+
+	idx = srcu_read_lock(&qcom_iommu_device_fault_srcu);
+	entry = xa_load(&qcom_iommu_device_faults, (unsigned long)dev);
+	if (entry) {
+		mutex_lock(&entry->lock);
+		ret = entry->handler(fault, entry->data);
+		mutex_unlock(&entry->lock);
+	}
+	srcu_read_unlock(&qcom_iommu_device_fault_srcu, idx);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_iommu_report_device_fault);
 
