+/* Caller holds uport->lock; a flush starts a new FIFO generation. */
+static unsigned int msm_geni_tx_snapshot(struct msm_geni_serial_port *port)
+{
+	struct tty_port *tport;
+	unsigned int count;
+
+	if (!port->uport.state || port->tx_mapped || port->removing ||
+	    port->tx_cancel_pending || atomic_read(&port->flush_buffers))
+		return 0;
+	tport = &port->uport.state->port;
+	count = kfifo_out_peek(&tport->xmit_fifo, port->tx_buf, UART_XMIT_SIZE);
+	port->tx_active_generation = port->tx_generation;
+	return count;
+}
+
+static void msm_geni_tx_unmap(struct msm_geni_serial_port *port)
+{
+	if (!port->tx_mapped)
+		return;
+	geni_se_tx_dma_unprep(&port->se, port->tx_dma, port->xmit_size);
+	port->tx_mapped = false;
+	port->tx_dma = 0;
+	port->xmit_size = 0;
+}
+
+static void msm_geni_tx_complete(struct msm_geni_serial_port *port)
+{
+	struct uart_port *uport = &port->uport;
+	unsigned int count = port->xmit_size;
+
+	if (!port->tx_mapped)
+		return;
+	if (uport->state && port->tx_active_generation == port->tx_generation) {
+		unsigned int consumed = min(count, kfifo_len(&uport->state->port.xmit_fifo));
+
+		uart_xmit_advance(uport, consumed);
+		uport->icount.tx += count - consumed;
+	} else {
+		/* Bytes already sent still count after userspace flushed the FIFO. */
+		uport->icount.tx += count;
+	}
+	msm_geni_tx_unmap(port);
+}
+
