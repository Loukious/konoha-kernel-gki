+static void msm_geni_serial_release_slot(void *data)
+{
+	struct msm_geni_serial_port *port = data;
+	unsigned int line = port->uport.line;
+	bool is_console = port->is_console;
+
+	mutex_lock(&msm_geni_ports_lock);
+	memset(port, 0, sizeof(*port));
+	port->uport.iotype = UPIO_MEM;
+	port->uport.ops = is_console ? &msm_geni_console_pops : &msm_geni_serial_pops;
+	port->uport.flags = UPF_BOOT_AUTOCONF;
+	port->uport.line = line;
+	if (!is_console)
+		uart_line_id &= ~BIT(line);
+	mutex_unlock(&msm_geni_ports_lock);
+}
+
+static void msm_geni_serial_cleanup(struct msm_geni_serial_port *port)
+{
+	struct uart_port *uport = &port->uport;
+	int i;
+
+	WRITE_ONCE(port->removing, true);
+	device_remove_file(uport->dev, &dev_attr_loopback);
+	device_remove_file(uport->dev, &dev_attr_xfer_mode);
+	device_remove_file(uport->dev, &dev_attr_ver_info);
+	device_remove_file(uport->dev, &dev_attr_hs_uart_operation);
+	device_remove_file(uport->dev, &dev_attr_hs_uart_version);
+	device_remove_file(uport->dev, &dev_attr_capture_kpi);
+	if (port->wakeup_irq_requested) {
+		if (port->wakeup_enabled)
+			irq_set_irq_wake(port->wakeup_irq, 0);
+		devm_free_irq(uport->dev, port->wakeup_irq, uport);
+		port->wakeup_irq_requested = false;
+		port->wakeup_enabled = false;
+	}
+	if (port->wakeup_irq_wq) {
+		cancel_delayed_work_sync(&port->wakeup_irq_dwork);
+		destroy_workqueue(port->wakeup_irq_wq);
+		port->wakeup_irq_wq = NULL;
+	}
+	if (port->port_registered) {
+		uart_remove_one_port(uport->private_data, uport);
+		port->port_registered = false;
+	}
+	if (pm_runtime_enabled(uport->dev)) {
+		pm_runtime_get_noresume(uport->dev);
+		pm_runtime_barrier(uport->dev);
+		pm_runtime_disable(uport->dev);
+		pm_runtime_put_noidle(uport->dev);
+	}
+	if (port->tx_wq) {
+		cancel_work_sync(&port->tx_xfer_work);
+		cancel_work_sync(&port->tx_cancel_work);
+		destroy_workqueue(port->tx_wq);
+		port->tx_wq = NULL;
+	}
+	if (port->rx_wq) {
+		cancel_work_sync(&port->rx_cancel_work);
+		destroy_workqueue(port->rx_wq);
+		port->rx_wq = NULL;
+	}
+	msm_geni_deallocate_chan(uport);
+	msm_geni_tx_unmap(port);
+	msm_geni_gsi_put_tx_vote(port);
