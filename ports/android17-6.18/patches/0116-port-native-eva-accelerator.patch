+static void cvp_release_core(struct platform_device *pdev,
+			     struct msm_cvp_core *core)
+{
+	/* Withdraw new opens, then drain sessions while their hardware exists. */
+	mutex_lock(&cvp_driver->lock);
+	core->ready = false;
+	mutex_unlock(&cvp_driver->lock);
+	if (core->dsp_initialized)
+		cvp_dsp_device_exit();
+	cvp_put_core(core);
+	wait_for_completion(&core->users_zero);
+	if (core->dsp_initialized) {
+		cvp_dsp_device_deinit();
+		core->dsp_initialized = false;
+	}
+	debugfs_remove_recursive(cvp_driver->debugfs_root);
+	cvp_driver->debugfs_root = NULL;
+	cancel_work_sync(&core->ssr_work);
+	if (!IS_ERR_OR_NULL(core->dev_ops))
+		cvp_hfi_deinitialize(core->hfi_type, core->dev_ops);
+	of_platform_depopulate(&pdev->dev);
+	mutex_lock(&cvp_driver->lock);
+	cvp_driver->cvp_core = NULL;
+	mutex_unlock(&cvp_driver->lock);
+	msm_cvp_free_platform_resources(&core->resources);
+	kfree(core->capabilities);
+	idr_destroy(&core->sess_idr);
+	mutex_destroy(&core->idr_mtx);
+	mutex_destroy(&core->clk_lock);
+	mutex_destroy(&core->lock);
+	dev_set_drvdata(&pdev->dev, NULL);
+	kfree(core);
+}
+
+static int cvp_child_ready(struct device *dev, void *data)
+{
+	return device_is_bound(dev) ? 0 : -EPROBE_DEFER;
+}
