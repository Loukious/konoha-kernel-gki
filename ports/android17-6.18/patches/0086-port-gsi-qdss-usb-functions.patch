+static int ipa_usb_notify_cb(enum ipa_usb_notify_event event, void *driver_data)
+{
+	struct gsi_ipa_token *token = driver_data;
+	struct f_gsi *gsi;
+	unsigned long flags;
+	int ret;
+
+	if (!token)
+		return -EINVAL;
+	spin_lock_irqsave(&token->lock, flags);
+	gsi = token->gsi;
+	if (gsi)
+		kref_get(&gsi->ref);
+	spin_unlock_irqrestore(&token->lock, flags);
+	if (!gsi)
+		return -ENODEV;
+	ret = ipa_usb_notify_gsi(event, gsi);
+	gsi_put(gsi);
+	return ret;
+}
