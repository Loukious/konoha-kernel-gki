+static bool gsi_rndis_message_valid(const void *data, size_t actual)
+{
+	const u8 *buf = data;
+	u32 type, len, size, offset;
+	size_t minimum;
+
+	if (!buf || actual < 8)
+		return false;
+	type = get_unaligned_le32(buf);
+	len = get_unaligned_le32(buf + 4);
+	switch (type) {
+	case RNDIS_MSG_INIT:
+		minimum = sizeof(rndis_init_msg_type);
+		break;
+	case RNDIS_MSG_QUERY:
+		minimum = sizeof(rndis_query_msg_type);
+		break;
+	case RNDIS_MSG_SET:
+		minimum = sizeof(rndis_set_msg_type);
+		break;
+	case RNDIS_MSG_HALT:
+		minimum = sizeof(rndis_halt_msg_type);
+		break;
+	case RNDIS_MSG_RESET:
+		minimum = sizeof(rndis_reset_msg_type);
+		break;
+	case RNDIS_MSG_KEEPALIVE:
+		minimum = sizeof(rndis_keepalive_msg_type);
+		break;
+	default:
+		return false;
+	}
+	if (len < minimum || len > actual)
+		return false;
+	if (type != RNDIS_MSG_QUERY && type != RNDIS_MSG_SET)
+		return true;
+	size = get_unaligned_le32(buf + 16);
+	offset = get_unaligned_le32(buf + 20);
+	if (offset > len - 8 || size > len - 8 - offset)
+		return false;
+	if (size && offset < minimum - 8)
+		return false;
+	if (type == RNDIS_MSG_SET &&
+	    get_unaligned_le32(buf + 12) == RNDIS_OID_GEN_CURRENT_PACKET_FILTER &&
+	    size < sizeof(__le32))
+		return false;
+	return true;
+}
