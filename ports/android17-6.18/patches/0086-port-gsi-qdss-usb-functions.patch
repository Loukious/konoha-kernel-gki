+
+static int gsi_ipa_module_notify(struct notifier_block *nb,
+				 unsigned long state, void *data)
+{
+	struct module *mod = data;
+	struct gsi_ipa_module *entry, *tmp;
+	struct gsi_ipa_token *token, *token_tmp;
+	unsigned long flags;
+
+	if (state == MODULE_STATE_COMING) {
+		entry = kmalloc(sizeof(*entry), GFP_KERNEL);
+		if (!entry)
+			return NOTIFY_DONE;
+		entry->mod = mod;
+		spin_lock_irqsave(&ipa_ops_lock, flags);
+		list_add_tail(&entry->list, &ipa_modules);
+		spin_unlock_irqrestore(&ipa_ops_lock, flags);
+	} else if (state == MODULE_STATE_GOING) {
+		spin_lock_irqsave(&ipa_ops_lock, flags);
+		if (ipa_owner == mod) {
+			ipa_owner = NULL;
+			memset(&ipa_ops, 0, sizeof(ipa_ops));
+			reinit_completion(&wait_for_ipa_ready);
+		}
+		list_for_each_entry_safe(entry, tmp, &ipa_modules, list) {
+			if (entry->mod == mod) {
+				list_del(&entry->list);
+				kfree(entry);
+			}
+		}
+		/* Module exit must retire its own callback producers first. */
+		list_for_each_entry_safe(token, token_tmp, &ipa_tokens, list) {
+			if (token->owner == mod) {
+				list_del(&token->list);
+				kfree(token);
+			}
+		}
+		spin_unlock_irqrestore(&ipa_ops_lock, flags);
+	}
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block ipa_module_notifier = {
+	.notifier_call = gsi_ipa_module_notify,
+};
+
+static void gsi_ipa_registry_clear(void)
+{
+	struct gsi_ipa_module *entry, *tmp;
+	struct gsi_ipa_token *token, *token_tmp;
+
+	list_for_each_entry_safe(entry, tmp, &ipa_modules, list) {
+		list_del(&entry->list);
+		kfree(entry);
+	}
+	list_for_each_entry_safe(token, token_tmp, &ipa_tokens, list) {
+		list_del(&token->list);
+		kfree(token);
+	}
+}
+
+static int gsi_ipa_get(struct f_gsi *gsi)
+{
+	struct gsi_ipa_token *token;
+	unsigned long flags;
+	int ret = -ENODEV;
+
+	token = kzalloc(sizeof(*token), GFP_KERNEL);
+	if (!token)
+		return -ENOMEM;
+	spin_lock_init(&token->lock);
+	spin_lock_irqsave(&ipa_ops_lock, flags);
+	/* A failed module init may free COMING code despite a reference. */
+	if (ipa_owner && ipa_owner->state == MODULE_STATE_LIVE &&
+	    gsi_ipa_ops_valid(&ipa_ops) && try_module_get(ipa_owner)) {
+		token->owner = ipa_owner;
+		list_add_tail(&token->list, &ipa_tokens);
+		gsi->ipa_token = token;
+		gsi->ipa_owner = ipa_owner;
+		gsi->ipa_ops = ipa_ops;
+		gsi->d_port.ipa_ops = &gsi->ipa_ops;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&ipa_ops_lock, flags);
+	if (ret)
+		kfree(token);
+	return ret;
+}
+
+static void gsi_ipa_put(struct f_gsi *gsi)
+{
+	module_put(gsi->ipa_owner);
+	gsi->ipa_owner = NULL;
+	gsi->d_port.ipa_ops = NULL;
