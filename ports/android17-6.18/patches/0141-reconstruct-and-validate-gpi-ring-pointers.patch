--- a/drivers/dma/qcom/msm_gpi.c
+++ b/drivers/dma/qcom/msm_gpi.c
@@ -32,6 +32,10 @@
 #include "../dmaengine.h"
 #include "../virt-dma.h"
 #include "msm_gpi_mmio.h"
