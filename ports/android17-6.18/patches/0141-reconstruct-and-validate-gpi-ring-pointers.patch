 struct sg_tre {
@@ -692,9 +697,21 @@
 }
 
 static inline void *to_virtual(const struct gpi_ring *const ring,
-				      phys_addr_t addr)
-{
-	return ring->base + (addr - ring->phys_addr);
+			       phys_addr_t addr)
+{
+	phys_addr_t offset = addr - ring->phys_addr;
+
+	if (offset >= ring->len || !ring->el_size || offset % ring->el_size)
+		return NULL;
+	return ring->base + offset;
+}
+
+/* Hardware event RP registers contain only the low 32 DMA address bits. */
+static inline void *gpi_ring_ptr_lsb(const struct gpi_ring *ring, u32 addr)
+{
+	u32 offset = addr - lower_32_bits(ring->phys_addr);
+
+	return to_virtual(ring, ring->phys_addr + offset);
 }
 
 #if IS_ENABLED(CONFIG_MSM_GPI_DMA_DEBUG)
@@ -745,6 +762,29 @@
 	writel_relaxed(val, addr);
 }
 #endif
+
+static void *gpi_read_ev_ring_rp(struct gpii *gpii, phys_addr_t *addr)
+{
+	struct gpi_ring *ring = gpii->ev_ring;
+	u32 lsb = gpi_read_reg(gpii, gpii->ev_ring_rp_lsb_reg);
+	void *rp = gpi_ring_ptr_lsb(ring, lsb);
+
+	if (!rp) {
+		dev_err_ratelimited(gpii->gpi_dev->dev,
+				    "GPI %u invalid event RP %#x base=%pa len=%u el_size=%u\n",
+				    gpii->gpii_id, lsb, &ring->phys_addr,
+				    ring->len, ring->el_size);
+		return NULL;
+	}
+	*addr = to_physical(ring, rp);
+	if (boot_trace && !ring->rp_traced) {
+		ring->rp_traced = true;
+		dev_info(gpii->gpi_dev->dev,
+			 "Konoha boot: gpi.%u.event-rp lsb=%#x full=%pa base=%pa\n",
+			 gpii->gpii_id, lsb, addr, &ring->phys_addr);
+	}
+	return rp;
+}
 
