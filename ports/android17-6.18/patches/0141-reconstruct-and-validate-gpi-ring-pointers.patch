+module_param(boot_trace, bool, 0444);
+MODULE_PARM_DESC(boot_trace, "Log GPI DMA ring addresses and first event pointer");
 
 /* global logging macros */
 #define GPI_LOG(gpi_dev, fmt, ...) do { \
@@ -439,6 +443,7 @@
