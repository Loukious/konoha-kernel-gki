 int platform_class_buckchg_ops_register(unsigned int role, void *data,
 					struct platform_class_buckchg_ops *ops)
 {
+	struct platform_class_buckchg_data *entry;
+
+	if (role >= MAX_BUCK_CHARGER || !data || !ops)
+		return -EINVAL;
+	entry = kmalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+	entry->data = data;
+	entry->ops = ops;
+	mutex_lock(&mca_ops_lock);
+	if (rcu_access_pointer(platform_buckchg_ops_data[role])) {
+		mutex_unlock(&mca_ops_lock);
+		kfree(entry);
+		return -EEXIST;
+	}
+	rcu_assign_pointer(platform_buckchg_ops_data[role], entry);
+	mutex_unlock(&mca_ops_lock);
+	return 0;
+}
+EXPORT_SYMBOL(platform_class_buckchg_ops_register);
