+	mutex_lock(&info->policy_lock);
+	if (info->stopping)
+		ret = -ENODEV;
+	else if (!info->support_wireless)
+		ret = -EOPNOTSUPP;
+	else
+		*remove = info->wireless_ctrl_info.wls_thermal_remove;
+	mutex_unlock(&info->policy_lock);
+out:
+	srcu_read_unlock(&thermal_instance_srcu, index);
+	return ret;
+}
